# Growth System VSL funnel — public client-side values only (PUBLIC_*)

# YouTube video id, Vimeo id, Loom share id, or full direct MP4 URL
PUBLIC_VSL_VIDEO_ID=
# Optional override if you prefer a full URL (YouTube/Vimeo/Loom/direct)
PUBLIC_VSL_VIDEO_URL=

# Embedded scheduling URL (GoHighLevel / Calendly / custom)
PUBLIC_VSL_CALENDAR_EMBED_URL=

# DEPRECATED, unused: leads now post to /api/lead (server-side LEAD_WEBHOOK_URL below). Any PUBLIC_ value would ship in the browser bundle.
PUBLIC_VSL_GHL_WEBHOOK_URL=

# DEPRECATED, unused (see above).
PUBLIC_GHL_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Conversion tracking: SERVER-ONLY (read by src/pages/api/lead.ts on Vercel).
# No PUBLIC_ prefix: these must never reach the browser bundle.
# ---------------------------------------------------------------------------

# Where /api/lead forwards each lead as flat JSON (GHL inbound webhook or n8n webhook URL).
# Required in production: if unset, /api/lead returns 503, logs an error, and the form shows its error state.
# If unset under `astro dev`, /api/lead runs in dry-run (logs only, forwards nothing).
LEAD_WEBHOOK_URL=

# Meta Conversions API access token (Events Manager > dataset > Settings > Conversions API).
# If unset, the server-side Lead event is skipped (browser pixel still fires).
META_CAPI_ACCESS_TOKEN=

# Meta pixel / dataset id. Defaults to 1528990838912009 (the pixel in ConsentManager.astro).
META_PIXEL_ID=

# Optional: Events Manager "Test events" code. When set, CAPI events show under Test events
# instead of counting as live. Remove after testing.
META_TEST_EVENT_CODE=

# 1 = never forward anything: log the CRM payload and CAPI body, respond { ok: true, mode: "dry-run" }.
TRACKING_DRY_RUN=
