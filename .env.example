# Growth System VSL funnel — public client-side values only (PUBLIC_*)

# YouTube video id, Vimeo id, Loom share id, or full direct MP4 URL
PUBLIC_VSL_VIDEO_ID=
# Optional override if you prefer a full URL (YouTube/Vimeo/Loom/direct)
PUBLIC_VSL_VIDEO_URL=

# Embedded scheduling URL (GoHighLevel / Calendly / custom)
PUBLIC_VSL_CALENDAR_EMBED_URL=

# GoHighLevel inbound webhook for qualified funnel leads
PUBLIC_VSL_GHL_WEBHOOK_URL=

# Optional shared fallback webhook
PUBLIC_GHL_WEBHOOK_URL=

# AI & Agent Readiness Scanner (/ai-readiness-scanner) — public client-side values only
# Google PageSpeed Insights API key (free, 25k queries/day). Restrict it by HTTP referrer.
# Without a key the scanner still tries the shared keyless quota, which often returns 429.
PUBLIC_PSI_API_KEY=
# URL of a deployed scanner API implementing the contract in src/lib/scanner/types.ts
# (reference implementation: `node scripts/scanner-api.mjs`, needs OPENAI_API_KEY server-side).
# Powers the live "what ChatGPT thinks you sell" test and the pricing/schema HTML checks.
PUBLIC_SCANNER_API_URL=

# On-site Brand Agent (homepage prompt bar). Optional live rewrite of the matched playbook.
# Point this at POST /agent on the scanner API (scripts/scanner-api.mjs). Without it, the
# agent still answers instantly from the built-in industry playbooks.
PUBLIC_BRAND_AGENT_URL=
