# Growth System VSL funnel — public client-side values only (PUBLIC_*)

# YouTube video id, Vimeo id, Loom share id, or full direct MP4 URL
PUBLIC_VSL_VIDEO_ID=
# Optional override if you prefer a full URL (YouTube/Vimeo/Loom/direct)
PUBLIC_VSL_VIDEO_URL=

# Embedded scheduling URL (GoHighLevel / Calendly / custom)
PUBLIC_VSL_CALENDAR_EMBED_URL=

# GoHighLevel inbound webhook for qualified funnel leads
PUBLIC_VSL_GHL_WEBHOOK_URL=

# Optional shared fallback webhook
PUBLIC_GHL_WEBHOOK_URL=
