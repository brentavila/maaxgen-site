---
/** US-first cookie notice — disclosure only, no opt-out controls. */
---

<div
  id="cookie-notice"
  class="cookie-notice"
  hidden
  role="status"
  aria-live="polite"
  aria-labelledby="cookie-notice-title"
  aria-describedby="cookie-notice-desc"
>
  <div class="cookie-notice__panel">
    <h2 id="cookie-notice-title" class="sr-only">Cookie notice</h2>
    <p id="cookie-notice-desc" class="cookie-notice__text">
      We use cookies to measure site performance and marketing. We never sell your data.
      <a href="/privacy/">Privacy Policy</a>
    </p>
    <button type="button" class="cookie-notice__action" data-cookie-notice-dismiss>
      Got it
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var root = document.getElementById("cookie-notice");
    if (!root) return;

    function showNotice() {
      root.hidden = false;
    }

    function hideNotice() {
      root.hidden = true;
    }

    if (!window.MaaxCookieNotice || !window.MaaxCookieNotice.isDismissed()) {
      showNotice();
    }

    root.querySelector("[data-cookie-notice-dismiss]")?.addEventListener("click", function () {
      if (window.MaaxCookieNotice) window.MaaxCookieNotice.dismiss();
      hideNotice();
    });

    window.addEventListener("maaxgen:cookie-notice-show", showNotice);
    window.addEventListener("maaxgen:cookie-notice-dismiss", hideNotice);
  })();
</script>

<style is:global>
  /* Compact notice: a slim bottom bar on phones, a small corner card on wider screens.
     Kept short so it never covers the hero on a phone (it used to take about a third of the screen). */
  .cookie-notice {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 80;
    padding: 0.5rem;
    pointer-events: none;
  }

  .cookie-notice__panel {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 42rem;
    margin-inline: auto;
    padding: 0.55rem 0.6rem 0.55rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: oklch(0.995 0.005 245);
    box-shadow: 0 -0.25rem 1.25rem oklch(0.3 0.03 250 / 0.12);
  }

  .cookie-notice__text {
    flex: 1 1 auto;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .cookie-notice__text a {
    color: var(--color-brand);
    font-weight: 600;
    white-space: nowrap;
  }

  .cookie-notice__action {
    flex: 0 0 auto;
    min-height: 2.25rem;
    padding: 0.4rem 0.9rem;
    border: 0;
    border-radius: 0.5rem;
    background: var(--color-brand);
    color: #fff;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
  }

  .cookie-notice__action:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }

  @media (min-width: 40rem) {
    .cookie-notice {
      inset: auto 1.25rem 1.25rem auto;
      padding: 0;
      width: min(26rem, calc(100vw - 2.5rem));
    }

    .cookie-notice__panel {
      margin: 0;
    }
  }
</style>
