---
/** US-first cookie notice — disclosure only, no opt-out controls. */
---

<div
  id="cookie-notice"
  class="cookie-notice"
  hidden
  role="status"
  aria-live="polite"
  aria-labelledby="cookie-notice-title"
  aria-describedby="cookie-notice-desc"
>
  <div class="cookie-notice__panel">
    <div class="cookie-notice__copy">
      <p class="cookie-notice__eyebrow">Cookies</p>
      <h2 id="cookie-notice-title">We use cookies to improve your experience</h2>
      <p id="cookie-notice-desc">
        MaaxGen uses cookies and similar technologies to understand site performance, remember
        preferences, and measure marketing. We never sell your personal data to third parties.
        Read our <a href="/privacy">Privacy Policy</a> for details.
      </p>
    </div>
    <button type="button" class="btn btn--primary cookie-notice__action" data-cookie-notice-dismiss>
      Got it
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var root = document.getElementById("cookie-notice");
    if (!root) return;

    function showNotice() {
      root.hidden = false;
    }

    function hideNotice() {
      root.hidden = true;
    }

    if (!window.MaaxCookieNotice || !window.MaaxCookieNotice.isDismissed()) {
      showNotice();
    }

    root.querySelector("[data-cookie-notice-dismiss]")?.addEventListener("click", function () {
      if (window.MaaxCookieNotice) window.MaaxCookieNotice.dismiss();
      hideNotice();
    });

    window.addEventListener("maaxgen:cookie-notice-show", showNotice);
    window.addEventListener("maaxgen:cookie-notice-dismiss", hideNotice);
  })();
</script>

<style is:global>
  .cookie-notice {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 80;
    padding: 1rem;
    pointer-events: none;
  }

  .cookie-notice__panel {
    pointer-events: auto;
    max-width: 42rem;
    margin-inline: auto;
    padding: 1.25rem 1.35rem 1.35rem;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: oklch(0.995 0.005 245);
    box-shadow: 0 -0.5rem 2rem oklch(0.3 0.03 250 / 0.12);
  }

  .cookie-notice__eyebrow {
    margin: 0 0 0.35rem;
    color: var(--color-brand);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cookie-notice__copy h2 {
    margin: 0 0 0.5rem;
    color: var(--color-slate);
    font-size: clamp(1.1rem, 2.5vw, 1.3rem);
  }

  .cookie-notice__copy p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .cookie-notice__copy a {
    color: var(--color-brand);
    font-weight: 600;
  }

  .cookie-notice__action {
    width: 100%;
    justify-content: center;
    margin-top: 1.1rem;
  }

  @media (min-width: 40rem) {
    .cookie-notice {
      inset: auto 1.25rem 1.25rem auto;
      padding: 0;
      width: min(26rem, calc(100vw - 2.5rem));
    }

    .cookie-notice__panel {
      margin: 0;
    }
  }
</style>
