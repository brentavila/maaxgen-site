---
interface Props {
  landing?: boolean;
}

const { landing = false } = Astro.props;
const year = new Date().getFullYear();
---
<footer class:list={["site-footer", landing && "site-footer--landing"]}>
  <div class="container">
    {landing ? (
      <div class="site-footer__landing">
        <a href="/" class="logo" aria-label="MaaxGen home">
          <img
            src="/brand/Maaxgen Vector Logo with Icon.svg"
            alt="MaaxGen"
            width="400"
            height="246"
            class="logo__img"
            loading="lazy"
          />
          <span class="logo__fallback" hidden>
            <span class="logo__maax">MAAX</span><span class="logo__gen">GEN</span>
          </span>
        </a>
        <ul>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/terms">Terms</a></li>
          <li>
            <button type="button" class="footer-consent-link" data-open-consent>
              Cookie preferences
            </button>
          </li>
        </ul>
        <p class="copyright">&copy; {year} MaaxGen. All rights reserved.</p>
      </div>
    ) : (
      <>
        <div class="site-footer__grid">
          <div>
            <a href="/" class="logo" aria-label="MaaxGen home">
              <img
                src="/brand/Maaxgen Vector Logo with Icon.svg"
                alt="MaaxGen"
                width="400"
                height="246"
                class="logo__img"
                loading="lazy"
              />
              <span class="logo__fallback" hidden>
                <span class="logo__maax">MAAX</span><span class="logo__gen">GEN</span>
              </span>
            </a>
            <p class="site-footer__tagline">
              Marketing, advertising, and AI for local and e-commerce businesses - one bundled partner for growth.
            </p>
          </div>
          <div>
            <p class="site-footer__heading">Company</p>
            <ul>
              <li><a href="/about">About</a></li>
              <li><a href="/services">Services</a></li>
              <li><a href="/case-studies">Case studies</a></li>
              <li><a href="/ad-account-grader">Ad account grader</a></li>
              <li><a href="/pricing">Pricing</a></li>
              <li><a href="/contact">Contact</a></li>
            </ul>
          </div>
          <div>
            <p class="site-footer__heading">Legal</p>
            <ul>
              <li><a href="/privacy">Privacy</a></li>
              <li><a href="/terms">Terms</a></li>
              <li><a href="/blog">Blog</a></li>
              <li>
                <button type="button" class="footer-consent-link" data-open-consent>
                  Cookie preferences
                </button>
              </li>
            </ul>
          </div>
        </div>
        <p class="copyright">&copy; {year} MaaxGen. All rights reserved.</p>
      </>
    )}
  </div>
</footer>

<script is:inline>
  document.querySelectorAll("[data-open-consent]").forEach(function (button) {
    button.addEventListener("click", function () {
      if (window.MaaxConsent) window.MaaxConsent.openPreferences();
    });
  });
</script>

<style>
  .footer-consent-link {
    appearance: none;
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .footer-consent-link:hover {
    color: var(--color-brand);
  }
</style>
