---
import "../styles/promo.css";
import { PROMO, isPromoActive } from "../data/promo";
import { industries } from "../data/industries";

interface Props {
  landing?: boolean;
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  landing = false,
  ctaHref = "/ad-account-grader/",
  ctaLabel = "Grade my ads",
} = Astro.props;

const nav = [
  { href: "/", label: "Home" },
  { href: "/services/", label: "Services" },
  ...(industries.length > 0 ? [{ href: "/industries/", label: "Industries" }] : []),
  { href: "/case-studies/", label: "Case studies" },
  { href: "/ad-account-grader/", label: "Ad grader" },
  { href: "/blog/", label: "Blog" },
  { href: "/contact/", label: "Contact" },
];

const pathname = Astro.url.pathname;

const promoActive = isPromoActive(new Date());
const buildOff = (when: "active" | "ended") =>
  (when === "active") !== promoActive ? { "data-promo-build-off": "" } : {};

function isActive(href: string) {
  if (href === "/") return pathname === "/" || pathname === "";
  const base = href.endsWith("/") ? href.slice(0, -1) : href;
  const current = pathname.length > 1 && pathname.endsWith("/") ? pathname.slice(0, -1) : pathname;
  return current === base || current.startsWith(`${base}/`);
}
---
<script is:inline define:vars={{ promoStart: PROMO.start, promoEnd: PROMO.end }}>
  // Pre-paint: mark whether the promotion is live on the visitor's clock (same rule as isPromoActive).
  (function () {
    var now = Date.now();
    document.documentElement.setAttribute("data-promo", now >= Date.parse(promoStart) && now < Date.parse(promoEnd) ? "on" : "off");
  })();
</script>
{!landing && (
  <aside class="promo-bar" aria-label={`${PROMO.name} offer`} data-promo-when="active" {...buildOff("active")}>
    <div class="container promo-bar__inner">
      <p>
        <strong class="promo-bar__lead promo-bar__lead--offer">{PROMO.name}:</strong>
        <span class="promo-bar__long">{PROMO.benefits.map((b) => b.label).join(" · ")}</span>
        <span class="promo-bar__short">{PROMO.copy.barShort}</span>
      </p>
      <a href="/black-friday/" data-promo-cta data-promo-placement="bar">{PROMO.cta.see}</a>
    </div>
  </aside>
  <aside class="promo-bar" aria-label="Free ad account grader" data-promo-when="ended" {...buildOff("ended")}>
    <div class="container promo-bar__inner">
      <p>
        <strong class="promo-bar__lead">Free two-minute diagnostic:</strong>
        <span class="promo-bar__long">Find the weak point in the system around your ads.</span>
        <span class="promo-bar__short">Free two-minute ad diagnostic</span>
      </p>
      <a href="/ad-account-grader/">Get my grade</a>
    </div>
  </aside>
)}
<header class:list={["site-header", landing && "site-header--landing"]}>
  <div class="container site-header__inner">
    <a href="/" class="logo" aria-label="MaaxGen home">
      <img
        src="/brand/Maaxgen Vector Logo with Icon.svg"
        alt="MaaxGen"
        width="400"
        height="246"
        class="logo__img"
      />
      <span class="logo__fallback" hidden>
        <span class="logo__maax">MAAX</span><span class="logo__gen">GEN</span>
      </span>
    </a>
    {!landing && (
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <span class="menu-toggle__label">Menu</span>
        <svg class="menu-toggle__icon" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
          <path class="menu-toggle__bars" d="M2 4.5h14M2 9h14M2 13.5h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path class="menu-toggle__x" d="M3.5 3.5l11 11M14.5 3.5l-11 11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    )}
    {!landing && (
      <nav aria-label="Main" id="site-nav" class="site-nav">
        <ul class="nav">
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <a class="btn btn--primary site-header__cta" href={ctaHref}>{ctaLabel}</a>
  </div>
</header>
<script is:inline>
  (function () {
    document.querySelectorAll(".logo__img").forEach(function (img) {
      var fallback = img.nextElementSibling;
      if (!fallback || !fallback.classList.contains("logo__fallback")) return;
      function showFallback() {
        img.hidden = true;
        fallback.hidden = false;
      }
      img.addEventListener("error", showFallback);
      if (!img.complete || img.naturalWidth === 0) {
        if (img.complete) showFallback();
      }
    });
  })();

  (function () {
    var header = document.querySelector(".site-header");
    var btn = header && header.querySelector(".menu-toggle");
    var nav = header && header.querySelector("#site-nav");
    if (!btn || !nav) return;
    var wide = window.matchMedia("(min-width: 48rem)");

    function setOpen(open, restoreFocus) {
      btn.setAttribute("aria-expanded", open ? "true" : "false");
      header.classList.toggle("is-menu-open", open);
      if (!open && restoreFocus) btn.focus();
    }
    function isOpen() {
      return btn.getAttribute("aria-expanded") === "true";
    }

    btn.addEventListener("click", function () {
      setOpen(!isOpen(), false);
    });
    nav.addEventListener("click", function (e) {
      if (e.target.closest && e.target.closest("a")) setOpen(false, false);
    });
    document.addEventListener("click", function (e) {
      if (isOpen() && !header.contains(e.target)) setOpen(false, false);
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && isOpen()) {
        e.preventDefault();
        setOpen(false, true);
      }
    });
    header.addEventListener("focusout", function (e) {
      if (isOpen() && e.relatedTarget && !header.contains(e.relatedTarget)) {
        setOpen(false, false);
      }
    });
    function onWide() {
      if (wide.matches) setOpen(false, false);
    }
    if (wide.addEventListener) wide.addEventListener("change", onWide);
    else if (wide.addListener) wide.addListener(onWide);
  })();
</script>
<script>
  import { initPromo } from "../components/promo/promo-client";
  initPromo();
</script>
