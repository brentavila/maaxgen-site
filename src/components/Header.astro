---
interface Props {
  landing?: boolean;
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  landing = false,
  ctaHref = "/ad-account-grader",
  ctaLabel = "Check my AI readiness",
} = Astro.props;

const nav = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/case-studies", label: "Case studies" },
  { href: "/ad-account-grader", label: "Ad grader" },
  { href: "/blog", label: "Blog" },
  { href: "/contact", label: "Contact" },
];

const pathname = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") return pathname === "/" || pathname === "";
  return pathname === href || pathname.startsWith(`${href}/`);
}
---
{!landing && (
  <aside class="promo-bar" aria-label="Free AI and ad readiness check">
    <div class="container promo-bar__inner">
      <p>
        <strong>Will AI recommend your business—or your competitor?</strong>
        <small class="promo-bar__detail">Run a free 60-second AI &amp; Ad Readiness Check.</small>
      </p>
      <a href="/ad-account-grader">Check my readiness →</a>
    </div>
  </aside>
)}
<header class:list={["site-header", landing && "site-header--landing"]}>
  <div class="container site-header__inner">
    <a href="/" class="logo" aria-label="MaaxGen home">
      <img
        src="/brand/Maaxgen Vector Logo with Icon.svg"
        alt="MaaxGen"
        width="400"
        height="246"
        class="logo__img"
      />
      <span class="logo__fallback" hidden>
        <span class="logo__maax">MAAX</span><span class="logo__gen">GEN</span>
      </span>
    </a>
    {!landing && (
      <nav aria-label="Main">
        <ul class="nav">
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <a class="btn btn--primary site-header__cta" href={ctaHref}>{ctaLabel}</a>
  </div>
</header>
<script is:inline>
  (function () {
    document.querySelectorAll(".logo__img").forEach(function (img) {
      var fallback = img.nextElementSibling;
      if (!fallback || !fallback.classList.contains("logo__fallback")) return;
      function showFallback() {
        img.hidden = true;
        fallback.hidden = false;
      }
      img.addEventListener("error", showFallback);
      if (!img.complete || img.naturalWidth === 0) {
        if (img.complete) showFallback();
      }
    });
  })();
</script>
