---
import { VIDEO_CONFIG, resolveVideoSrc } from "../../funnel/config";
import type { VideoProvider } from "../../funnel/types";

interface Props {
  provider?: VideoProvider;
  src?: string;
  title?: string;
}

const provider = Astro.props.provider ?? VIDEO_CONFIG.provider;
const src = (Astro.props.src ?? resolveVideoSrc()).trim();
const title = Astro.props.title ?? VIDEO_CONFIG.title;

function youtubeEmbed(idOrUrl: string): string {
  if (idOrUrl.includes("youtube.com") || idOrUrl.includes("youtu.be")) {
    try {
      const url = new URL(idOrUrl);
      if (url.hostname.includes("youtu.be")) return url.pathname.slice(1);
      return url.searchParams.get("v") || idOrUrl;
    } catch {
      return idOrUrl;
    }
  }
  return idOrUrl;
}

function vimeoEmbed(idOrUrl: string): string {
  const match = idOrUrl.match(/vimeo\.com\/(?:video\/)?(\d+)/);
  return match?.[1] ?? idOrUrl;
}

function loomEmbed(idOrUrl: string): string {
  const match = idOrUrl.match(/loom\.com\/(?:share|embed)\/([a-zA-Z0-9]+)/);
  return match?.[1] ?? idOrUrl;
}

let embedUrl = "";
if (src) {
  if (provider === "youtube") {
    const id = youtubeEmbed(src);
    embedUrl = `https://www.youtube.com/embed/${id}?enablejsapi=1&rel=0&modestbranding=1`;
  } else if (provider === "vimeo") {
    const id = vimeoEmbed(src);
    embedUrl = `https://player.vimeo.com/video/${id}?api=1`;
  } else if (provider === "loom") {
    const id = loomEmbed(src);
    embedUrl = `https://www.loom.com/embed/${id}`;
  } else {
    embedUrl = src;
  }
}
---

<div
  class="vsl-player"
  data-vsl-player
  data-provider={provider}
  data-has-src={src ? "true" : "false"}
>
  {src && provider !== "direct" ? (
    <div class="vsl-player__frame">
      <iframe
        data-vsl-iframe
        src={embedUrl}
        title={title}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        loading="lazy"
      />
    </div>
  ) : src && provider === "direct" ? (
    <div class="vsl-player__frame vsl-player__frame--direct">
      <video data-vsl-video controls playsinline preload="metadata" title={title}>
        <source src={src} />
        Your browser does not support embedded video.
      </video>
    </div>
  ) : (
    <div class="vsl-player__placeholder" role="region" aria-label="Video placeholder">
      <p class="vsl-player__placeholder-label">Video presentation</p>
      <p>
        Add your VSL via <code>PUBLIC_VSL_VIDEO_ID</code> or <code>PUBLIC_VSL_VIDEO_URL</code>.
        YouTube, Vimeo, Loom, and direct MP4 are supported.
      </p>
      <button type="button" class="btn btn--secondary" data-vsl-simulate>
        Simulate watch progress (dev)
      </button>
    </div>
  )}
</div>

<script>
  import { trackFunnelEvent } from "../../funnel/track";

  const milestones = [
    { pct: 0, event: "vsl_started", key: "vsl_started" },
    { pct: 25, event: "vsl_25", key: "vsl_25" },
    { pct: 50, event: "vsl_50", key: "vsl_50" },
    { pct: 75, event: "vsl_75", key: "vsl_75" },
    { pct: 90, event: "vsl_90", key: "vsl_90" },
    { pct: 100, event: "vsl_completed", key: "vsl_completed" },
  ] as const;

  function fireMilestone(pct: number) {
    for (const m of milestones) {
      if (pct >= m.pct) {
        trackFunnelEvent(m.event, { video_percent: m.pct }, { onceKey: m.key });
      }
    }
  }

  function bindDirectVideo(root: HTMLElement) {
    const video = root.querySelector<HTMLVideoElement>("[data-vsl-video]");
    if (!video) return;

    video.addEventListener("play", () => fireMilestone(0), { once: true });
    video.addEventListener("timeupdate", () => {
      if (!video.duration) return;
      fireMilestone((video.currentTime / video.duration) * 100);
    });
    video.addEventListener("ended", () => fireMilestone(100));
  }

  function bindYoutube(root: HTMLElement) {
    const iframe = root.querySelector<HTMLIFrameElement>("[data-vsl-iframe]");
    if (!iframe) return;

    const ensureApi = () =>
      new Promise<void>((resolve) => {
        const w = window as Window & {
          YT?: { Player: new (el: HTMLElement | string, opts: object) => YTPlayer };
          onYouTubeIframeAPIReady?: () => void;
        };
        if (w.YT?.Player) {
          resolve();
          return;
        }
        const prior = w.onYouTubeIframeAPIReady;
        w.onYouTubeIframeAPIReady = () => {
          prior?.();
          resolve();
        };
        if (!document.querySelector("script[data-yt-iframe-api]")) {
          const tag = document.createElement("script");
          tag.src = "https://www.youtube.com/iframe_api";
          tag.dataset.ytIframeApi = "true";
          document.head.appendChild(tag);
        }
      });

    type YTPlayer = {
      getCurrentTime: () => number;
      getDuration: () => number;
      destroy: () => void;
    };

    ensureApi().then(() => {
      const w = window as Window & {
        YT: { Player: new (el: HTMLElement | string, opts: object) => YTPlayer };
      };
      if (!iframe.id) iframe.id = `vsl-yt-${Math.random().toString(36).slice(2)}`;
      let timer: number | undefined;
      new w.YT.Player(iframe.id, {
        events: {
          onStateChange: (event: { data: number; target: YTPlayer }) => {
            // 1 playing, 2 paused, 0 ended
            if (event.data === 1) {
              fireMilestone(0);
              window.clearInterval(timer);
              timer = window.setInterval(() => {
                const duration = event.target.getDuration();
                if (!duration) return;
                fireMilestone((event.target.getCurrentTime() / duration) * 100);
              }, 1000);
            }
            if (event.data === 0) {
              window.clearInterval(timer);
              fireMilestone(100);
            }
            if (event.data === 2) window.clearInterval(timer);
          },
        },
      });
    });
  }

  function bindVimeo(root: HTMLElement) {
    const iframe = root.querySelector<HTMLIFrameElement>("[data-vsl-iframe]");
    if (!iframe) return;

    window.addEventListener("message", (event) => {
      if (!event.origin.includes("vimeo.com")) return;
      let data: { event?: string; data?: { percent?: number } };
      try {
        data = typeof event.data === "string" ? JSON.parse(event.data) : event.data;
      } catch {
        return;
      }
      if (data?.event === "play") fireMilestone(0);
      if (data?.event === "playProgress" && data.data?.percent != null) {
        fireMilestone(data.data.percent * 100);
      }
      if (data?.event === "finish") fireMilestone(100);
    });

    iframe.addEventListener("load", () => {
      const methods = ["addEventListener"];
      for (const method of methods) {
        iframe.contentWindow?.postMessage(
          JSON.stringify({ method, value: "play" }),
          "*"
        );
        iframe.contentWindow?.postMessage(
          JSON.stringify({ method, value: "playProgress" }),
          "*"
        );
        iframe.contentWindow?.postMessage(
          JSON.stringify({ method, value: "finish" }),
          "*"
        );
      }
    });
  }

  function bindPlaceholder(root: HTMLElement) {
    const btn = root.querySelector<HTMLButtonElement>("[data-vsl-simulate]");
    if (!btn) return;
    btn.addEventListener("click", () => {
      fireMilestone(0);
      window.setTimeout(() => fireMilestone(25), 200);
      window.setTimeout(() => fireMilestone(50), 400);
      window.setTimeout(() => fireMilestone(75), 600);
      window.setTimeout(() => fireMilestone(90), 800);
      window.setTimeout(() => fireMilestone(100), 1000);
      btn.textContent = "Progress events queued";
      btn.disabled = true;
    });
  }

  function init() {
    document.querySelectorAll<HTMLElement>("[data-vsl-player]").forEach((root) => {
      if (root.dataset.bound === "true") return;
      root.dataset.bound = "true";
      const provider = root.dataset.provider;
      if (root.dataset.hasSrc !== "true") {
        bindPlaceholder(root);
        return;
      }
      if (provider === "direct") bindDirectVideo(root);
      else if (provider === "youtube") bindYoutube(root);
      else if (provider === "vimeo") bindVimeo(root);
      else if (provider === "loom") {
        // Loom does not expose reliable progress APIs in embed; track start on interaction.
        root.addEventListener(
          "pointerdown",
          () => fireMilestone(0),
          { once: true }
        );
      }
    });
  }

  init();
</script>
