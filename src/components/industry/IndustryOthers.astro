---
/** Compact internal links to the other industry pages, the hub, and the services page. */
import type { Industry } from "../../data/industries";
import { industries } from "../../data/industries";

interface Props {
  industry: Industry;
}
const { industry } = Astro.props;
const others = industries.filter((i) => i.slug !== industry.slug);
---

<nav class="ind-others" aria-labelledby="others-title">
  <div class="container">
    <div class="ind-others__head">
      <h2 class="ind-others__title" id="others-title">Other industries we market for</h2>
      <p class="ind-others__links">
        <a href="/industries/">All industries</a>
        <span aria-hidden="true">·</span>
        <a href="/services/">See every service <span aria-hidden="true">→</span></a>
      </p>
    </div>
    <ul class="ind-others__list" role="list">
      {others.map((o) => (
        <li>
          <a class="ind-others__link" href={`/industries/${o.slug}/`}>
            <span class="ind-others__name">{o.shortName}</span>
            <span class="ind-others__blurb">{o.hubBlurb}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>
