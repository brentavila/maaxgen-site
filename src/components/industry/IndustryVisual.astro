---
/**
 * IndustryVisual — two bespoke, living scenes per industry landing page.
 * Same hand, palette and contract as ServiceVisual:
 *
 *   <IndustryVisual id="gd-emergency" uid="card" />
 *
 * - Root: <div class="sv sv--{id}" aria-hidden="true"> with one inline SVG (viewBox 320x280, 8:7).
 * - Every SVG id is suffixed with `uid` so the same visual can render more than once per page.
 * - Motion is CSS only and paused by default. It runs when an ancestor has [data-sv-play]
 *   or while the visual is hovered. Never animates under prefers-reduced-motion.
 * - The un-animated (paused, first-frame) state of every visual is its finished still.
 * - Shares ServiceVisual's base classes (.sv, .fc/.fs/.fa…, .sv-lbl, .a). The base block at the
 *   top of the stylesheet below is an identical copy so this component also works on its own.
 */
interface Props {
  id: string;
  uid?: string;
}

const { id, uid } = Astro.props;

const TINTS: Record<string, "blue" | "sand" | "sage" | "paper" | "dark"> = {
  "gd-emergency": "dark",
  "gd-service-area": "sage",
  "auto-bays": "dark",
  "auto-followup": "paper",
  "shop-profit": "blue",
  "shop-feed": "dark",
  "cars-inventory": "sand",
  "cars-lead": "dark",
  "law-intake": "paper",
  "law-pipeline": "dark",
  "kb-before-after": "sand",
  "kb-consult": "sage",
};

const known = Object.prototype.hasOwnProperty.call(TINTS, id);
const tint = known ? TINTS[id] : "paper";
const u = String(uid ?? Math.random().toString(36).slice(2, 8)).replace(/[^a-zA-Z0-9_-]/g, "") || "x";
const idKey = String(id).replace(/[^a-zA-Z0-9_-]/g, "") || "x";
const ref = (n: string) => `sv-${n}-${idKey}-${u}`;
const url = (n: string) => `url(#${ref(n)})`;
const sh = url("sh");
const rootClass = `sv sv--${known ? id : "unknown"} sv--t-${tint}${tint === "dark" ? " sv--dark" : ""}`;

/* Shared glyphs */
const phone =
  "M-6.5 -4.5 C-6.5 -6 -5.5 -7 -4 -7 L-2.5 -7 L-1 -3.5 L-2.8 -2.2 C-1.8 0 0 1.8 2.2 2.8 L3.5 1 L7 2.5 L7 4 C7 5.5 6 6.5 4.5 6.5 C-1.5 6.5 -6.5 1.5 -6.5 -4.5 Z";
const check = "M-3 0.1 L-0.9 2.2 L3.1 -1.9";
/* Neutral side-profile car, 100 wide, wheels sit on y=36.2 */
const carBody =
  "M3 27 V20 C3 16.5 5 15 9 14.4 L25 12 L37 4.2 C39.2 2.8 41.5 2.2 44.5 2.2 H64 C67.5 2.2 70 3.2 72.4 5.4 L80 12.2 L92 14 C95.4 14.6 97 16.6 97 20 V27 C97 28.4 96 29.2 94.6 29.2 H5.4 C4 29.2 3 28.4 3 27 Z";
const carWin =
  "M39.5 6.2 C40.8 5.3 42.4 5 44 5 H52 V12 H29.5 Z M55 5 H63.6 C66 5 67.8 5.8 69.6 7.4 L74.4 12 H55 Z";
/* Small map pin, tip at 0,0 */
const pin = "M0 0 C-2 -4.6 -7 -7.6 -7 -13.4 A7 7 0 1 1 7 -13.4 C7 -7.6 2 -4.6 0 0 Z";
/* Case-file folder, 72 x 36 */
const folder = (x: number, y: number) =>
  `M${x} ${y + 4} A4 4 0 0 1 ${x + 4} ${y} H${x + 22} L${x + 26} ${y + 4} H${x + 68} A4 4 0 0 1 ${x + 72} ${y + 8} V${y + 32} A4 4 0 0 1 ${x + 68} ${y + 36} H${x + 4} A4 4 0 0 1 ${x} ${y + 32} Z`;
const tee = "M-6 -9 L-11 -6 L-14 -1 L-10 1.5 L-8 0 V9 H8 V0 L10 1.5 L14 -1 L11 -6 L6 -9 C4.5 -6.5 -4.5 -6.5 -6 -9 Z";

/* auto-bays: [startDay, spanDays, new?] per bay */
const bays = [
  [[0, 2, 0], [2, 1, 1], [3, 2, 0]],
  [[0, 1, 1], [1, 3, 0], [4, 1, 1]],
  [[0, 3, 0], [3, 2, 1]],
];
let bayNew = 0;
const bayBlocks = bays.flatMap((row, r) =>
  row.map(([c, s, n]) => ({ x: 178 + c * 23, y: 75 + r * 48, w: s * 23 - 2, n: !!n, k: n ? bayNew++ : -1 }))
);

/* cars-inventory bunting */
const bunting = Array.from({ length: 12 }, (_, i) => {
  const x = 36 + i * 22.6;
  const t = (x - 28) / 264;
  return { x, y: 52 + 20 * t * (1 - t), alt: i % 2 === 0 };
});
---
<div class={rootClass} aria-hidden="true">
  <svg viewBox="0 0 320 280" xmlns="http://www.w3.org/2000/svg" focusable="false" preserveAspectRatio="xMidYMid meet">
    <defs>
      <filter id={ref("sh")} x="-20%" y="-20%" width="140%" height="150%" color-interpolation-filters="sRGB">
        <feDropShadow class="sv-sh1" dx="0" dy="1" stdDeviation="0.8" flood-color="#0b1b2e" />
        <feDropShadow class="sv-sh2" dx="0" dy="6" stdDeviation="8" flood-color="#0b1b2e" />
      </filter>
      <clipPath id={ref("c1")}>
        {id === "gd-emergency" && <rect x="52" y="140" width="132" height="110" />}
        {id === "gd-service-area" && <rect x="20" y="40" width="280" height="224" rx="14" />}
        {id === "kb-before-after" && <rect x="20" y="40" width="280" height="222" rx="12" />}
      </clipPath>
      {id === "kb-before-after" && (
        <clipPath id={ref("c2")}>
          <rect x="20" y="40" width="280" height="222" class="a kba-wipe" />
        </clipPath>
      )}
    </defs>

    {/* ───────────────────── Garage doors · emergency call ───────────────────── */}
    {id === "gd-emergency" && (
      <g>
        <text class="sv-lbl" x="20" y="26">EMERGENCY / CALL</text>
        <circle cx="46" cy="62" r="8" style="fill:oklch(0.86 0.04 85)" />
        <circle cx="50.5" cy="58.5" r="7" style="fill:var(--sv-bg)" />
        <circle cx="80" cy="46" r="1.1" class="fm" opacity=".7" />
        <circle cx="26" cy="84" r="1" class="fm" opacity=".6" />
        <circle cx="98" cy="60" r=".9" class="fm" opacity=".6" />

        <path d="M18 108 L118 56 L218 108 Z" class="fs" />
        <rect x="30" y="108" width="176" height="142" class="fc" />
        <rect x="14" y="105" width="208" height="5" rx="2" style="fill:oklch(0.5 0.02 250)" />
        <circle cx="118" cy="86" r="7" class="fc" />
        <path d="M113 84 H123 M113 88 H123" class="sl" stroke-width="1.2" />
        <path d="M30 122 H46 M30 131 H46 M30 140 H46 M30 172 H46 M30 181 H46 M30 190 H46 M30 199 H46 M30 208 H46 M30 217 H46 M30 226 H46 M30 235 H46 M30 244 H46 M190 122 H206 M190 131 H206 M190 140 H206 M190 172 H206 M190 181 H206 M190 190 H206 M190 199 H206 M190 208 H206 M190 217 H206 M190 226 H206 M190 235 H206 M190 244 H206 M30 122 H206" class="sl" opacity=".7" />
        <circle cx="38" cy="156" r="10" style="fill:oklch(0.86 0.06 85)" opacity=".14" />
        <rect x="35" y="150" width="6" height="11" rx="2" style="fill:oklch(0.86 0.06 85)" />
        <circle cx="198" cy="156" r="10" style="fill:oklch(0.86 0.06 85)" opacity=".14" />
        <rect x="195" y="150" width="6" height="11" rx="2" style="fill:oklch(0.86 0.06 85)" />

        <rect x="46" y="134" width="144" height="116" rx="3" style="fill:oklch(0.44 0.02 250)" />
        <rect x="52" y="140" width="132" height="110" style="fill:oklch(0.16 0.015 250)" />
        <ellipse cx="118" cy="150" rx="26" ry="9" style="fill:oklch(0.86 0.05 85)" opacity=".12" />
        <rect x="111" y="144" width="14" height="4" rx="2" style="fill:oklch(0.86 0.05 85)" />
        <rect x="52" y="140" width="3" height="110" style="fill:oklch(0.3 0.015 250)" />
        <rect x="181" y="140" width="3" height="110" style="fill:oklch(0.3 0.015 250)" />
        <ellipse cx="118" cy="246" rx="44" ry="3" fill="#000" opacity=".4" />
        <path d="M90 200 L97 180 C98 178 100 177 103 177 H133 C136 177 138 178 139 180 L146 200 Z" style="fill:oklch(0.52 0.02 250)" />
        <path d="M95 198 L100.5 183 H135.5 L141 198 Z" style="fill:oklch(0.25 0.015 250)" />
        <rect x="80" y="197" width="76" height="32" rx="8" style="fill:oklch(0.58 0.02 250)" />
        <rect x="84" y="204" width="15" height="6" rx="3" style="fill:oklch(0.62 0.08 30)" />
        <rect x="137" y="204" width="15" height="6" rx="3" style="fill:oklch(0.62 0.08 30)" />
        <rect x="108" y="213" width="20" height="9" rx="2" style="fill:oklch(0.86 0.01 250)" />
        <rect x="82" y="225" width="72" height="5" rx="2.5" style="fill:oklch(0.42 0.02 250)" />
        <rect x="84" y="228" width="13" height="16" rx="3" style="fill:oklch(0.12 0.01 250)" />
        <rect x="139" y="228" width="13" height="16" rx="3" style="fill:oklch(0.12 0.01 250)" />

        <g clip-path={url("c1")}>
          <g class="a gde-door">
            {[0, 1, 2, 3].map((s) => (
              <g>
                <rect x="52" y={140 + s * 27.5} width="132" height="27.5" style="fill:oklch(0.88 0.006 250)" />
                {[0, 1, 2, 3].map((k) => (
                  <rect x={57.6 + k * 31.6} y={145 + s * 27.5} width="26" height="17.5" rx="2" style={s === 0 ? "fill:oklch(0.32 0.02 250)" : "fill:oklch(0.8 0.01 250)"} />
                ))}
                <path d={`M52 ${140 + s * 27.5} H184`} style="stroke:oklch(0.68 0.01 250)" />
              </g>
            ))}
            <rect x="112" y="240" width="12" height="3" rx="1.5" style="fill:oklch(0.6 0.01 250)" />
            <rect x="52" y="247.5" width="132" height="2.5" style="fill:oklch(0.35 0.015 250)" />
          </g>
        </g>
        <path d="M20 250.5 H300" class="sl" />
        <path d="M52 251 H184 L198 280 H38 Z" class="fs" opacity=".35" />

        <g class="a gde-tile">
          <rect x="178" y="40" width="126" height="58" rx="14" class="fc" filter={sh} />
          <circle cx="199" cy="69" r="12" class="fa" style="fill-opacity:.2" />
          <circle cx="199" cy="69" r="12" class="sa a gde-ring" stroke-width="1.4" vector-effect="non-scaling-stroke" />
          <g transform="translate(199 69)"><path d={phone} class="fa a gde-hs" /></g>
          <text x="218" y="66" class="tx fi a gde-t1" font-size="9.5" font-weight="700">Incoming call</text>
          <text x="218" y="66" class="tx fi a gde-t2" font-size="9.5" font-weight="700">Answered</text>
          <rect x="218" y="73" width="62" height="5" rx="2.5" class="fs" />
          <g transform="translate(300 44)">
            <g class="a gde-check">
              <circle r="7.5" class="fa" stroke="#fff" stroke-width="1.6" />
              <path d={check} fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </g>
          </g>
        </g>
      </g>
    )}

    {/* ───────────────────── Garage doors · service area ───────────────────── */}
    {id === "gd-service-area" && (
      <g>
        <text class="sv-lbl" x="20" y="26">SERVICE AREA / ZONES</text>
        <rect x="20" y="40" width="280" height="224" rx="14" class="fc" filter={sh} />
        <g clip-path={url("c1")}>
          <rect x="20" y="40" width="280" height="224" style="fill:oklch(0.975 0.006 150)" />
          <rect x="236" y="52" width="58" height="44" rx="10" style="fill:oklch(0.9 0.05 150)" />
          <circle cx="252" cy="68" r="5" style="fill:oklch(0.84 0.06 150)" />
          <circle cx="274" cy="82" r="7" style="fill:oklch(0.84 0.06 150)" />
          <rect x="28" y="190" width="34" height="26" rx="6" style="fill:oklch(0.94 0.008 250)" />
          <rect x="266" y="150" width="30" height="40" rx="6" style="fill:oklch(0.94 0.008 250)" />
          <path d="M20 140 H300 M70 40 V264 M260 40 V264 M20 228 H300" fill="none" stroke-width="2.5" style="stroke:oklch(0.91 0.01 250)" />
          <path d="M20 176 H300 M120 40 V264 M212 40 V264 M20 104 L300 70" fill="none" stroke-width="9" stroke-linecap="round" style="stroke:oklch(0.93 0.008 250)" />
          <path d="M20 176 H300 M120 40 V264 M212 40 V264 M20 104 L300 70" fill="none" stroke="#fff" stroke-width="1" stroke-dasharray="4 5" />

          <path d="M58 92 L128 74 L150 130 L96 158 L52 136 Z" class="fa a gds-z" style="fill-opacity:.13" />
          <path d="M128 74 L214 70 L238 128 L150 130 Z" class="fa a gds-z gds-d1" style="fill-opacity:.13" />
          <path d="M96 158 L150 130 L238 128 L246 196 L170 214 L108 200 Z" class="fa a gds-z gds-d2" style="fill-opacity:.13" />
          <path d="M58 92 L128 74 L214 70 L238 128 L246 196 L170 214 L108 200 L96 158 L52 136 Z M128 74 L150 130 L96 158 M150 130 L238 128" class="sa" stroke-width="1.4" stroke-dasharray="4 3" stroke-linejoin="round" stroke-opacity=".75" />

          <g transform="translate(272 244)">
            <circle cy="-12" r="13" class="sl" stroke-dasharray="3 3" style="stroke:oklch(0.78 0.01 250)" />
            <g class="a gds-pin gds-d4">
              <path d={pin} style="fill:oklch(0.8 0.01 250)" />
              <circle cy="-13.4" r="2.6" fill="#fff" />
            </g>
          </g>
          {[[96, 124, 0], [182, 104, 1], [134, 192, 2], [208, 180, 3]].map(([x, y, d]) => (
            <g transform={`translate(${x} ${y})`}>
              <ellipse rx="4" ry="1.4" class="fi" style="fill-opacity:.15" />
              <g class={`a gds-pin gds-d${d}`}>
                <path d={pin} class="fa" />
                <circle cy="-13.4" r="2.6" fill="#fff" />
              </g>
            </g>
          ))}

          <g transform="translate(146 162)">
            <g class="a gds-van">
              <path d="M3 -1.6 H19 M5 -1.6 V0 M9 -1.6 V0 M13 -1.6 V0 M17 -1.6 V0" class="sm" stroke-width="1.1" />
              <path d="M0 10 V3 C0 1.3 1.3 0 3 0 H22 C23.3 0 24.3 .6 25 1.6 L29.5 7 C30.2 7.9 31 8.6 32 9 C33.3 9.5 34 10.4 34 11.8 V14 C34 15 33.2 15.6 32.2 15.6 H1.6 C.7 15.6 0 14.9 0 14 Z" class="fa" />
              <path d="M23 2.6 H24.2 L28.2 7.4 H23 Z" fill="#fff" opacity=".9" />
              <rect x="4" y="5" width="14" height="3" rx="1.5" fill="#fff" opacity=".55" />
              <circle cx="7.5" cy="15.6" r="3.4" class="fi" />
              <circle cx="26.5" cy="15.6" r="3.4" class="fi" />
              <circle cx="7.5" cy="15.6" r="1.2" fill="#fff" />
              <circle cx="26.5" cy="15.6" r="1.2" fill="#fff" />
            </g>
          </g>
        </g>
        <rect x="30" y="52" width="98" height="24" rx="8" class="fc" filter={sh} />
        <rect x="38.5" y="59.5" width="10" height="10" rx="3" class="fa" style="fill-opacity:.18" />
        <rect x="38.5" y="59.5" width="10" height="10" rx="3" class="sa" stroke-dasharray="2.5 2" />
        <text x="55" y="67.5" class="tx fi" font-size="8.5" font-weight="600">Service area</text>
      </g>
    )}

    {/* ───────────────────── Auto repair · bays this week ───────────────────── */}
    {id === "auto-bays" && (
      <g>
        <text class="sv-lbl" x="20" y="26">BAYS / THIS WEEK</text>
        <path d="M20 250.5 H140" class="sl" />
        <ellipse cx="77" cy="250" rx="44" ry="3" fill="#000" opacity=".3" />
        <rect x="26" y="64" width="102" height="8" rx="2" style="fill:oklch(0.5 0.02 250)" />
        <rect x="26" y="70" width="11" height="180" rx="2" style="fill:oklch(0.5 0.02 250)" />
        <rect x="117" y="70" width="11" height="180" rx="2" style="fill:oklch(0.5 0.02 250)" />
        <rect x="29.5" y="78" width="4" height="164" rx="2" style="fill:oklch(0.42 0.02 250)" />
        <rect x="120.5" y="78" width="4" height="164" rx="2" style="fill:oklch(0.42 0.02 250)" />
        <rect x="22" y="246" width="19" height="5" rx="1.5" style="fill:oklch(0.44 0.02 250)" />
        <rect x="113" y="246" width="19" height="5" rx="1.5" style="fill:oklch(0.44 0.02 250)" />
        <path d="M66 212 H88 L82 222 H72 Z" style="fill:oklch(0.46 0.02 250)" />
        <rect x="75.5" y="222" width="3" height="20" style="fill:oklch(0.42 0.02 250)" />
        <rect x="64" y="241" width="26" height="4" rx="2" style="fill:oklch(0.42 0.02 250)" />
        <circle cx="67" cy="247.5" r="2.5" style="fill:oklch(0.36 0.02 250)" />
        <circle cx="87" cy="247.5" r="2.5" style="fill:oklch(0.36 0.02 250)" />
        <g class="a aub-lift">
          <rect x="37" y="160" width="8" height="18" rx="1.5" style="fill:oklch(0.66 0.02 250)" />
          <rect x="109" y="160" width="8" height="18" rx="1.5" style="fill:oklch(0.66 0.02 250)" />
          <path d="M44 173 H70 M110 173 H84" stroke-width="4" stroke-linecap="round" style="stroke:oklch(0.66 0.02 250)" />
          <rect x="66" y="168" width="7" height="4" rx="1" style="fill:oklch(0.82 0.01 250)" />
          <rect x="81" y="168" width="7" height="4" rx="1" style="fill:oklch(0.82 0.01 250)" />
          <g transform="translate(77 172)">
            <path d="M-24 -22 L-18 -38 C-17 -40 -15.5 -41 -13 -41 H13 C15.5 -41 17 -40 18 -38 L24 -22 Z" style="fill:oklch(0.7 0.02 250)" />
            <path d="M-19.5 -24 L-14.5 -36.5 H14.5 L19.5 -24 Z" style="fill:oklch(0.27 0.015 250)" />
            <rect x="-38" y="-27" width="6" height="4" rx="1.5" style="fill:oklch(0.62 0.02 250)" />
            <rect x="32" y="-27" width="6" height="4" rx="1.5" style="fill:oklch(0.62 0.02 250)" />
            <rect x="-34" y="-24" width="68" height="22" rx="7" style="fill:oklch(0.74 0.02 250)" />
            <rect x="-29" y="-18" width="13" height="5" rx="2.5" style="fill:oklch(0.94 0.02 90)" />
            <rect x="16" y="-18" width="13" height="5" rx="2.5" style="fill:oklch(0.94 0.02 90)" />
            <rect x="-11" y="-17" width="22" height="7" rx="3" style="fill:oklch(0.3 0.015 250)" />
            <rect x="-32" y="-6" width="64" height="4" rx="2" style="fill:oklch(0.55 0.02 250)" />
            <rect x="-31" y="-2" width="12" height="14" rx="3" style="fill:oklch(0.13 0.01 250)" />
            <rect x="19" y="-2" width="12" height="14" rx="3" style="fill:oklch(0.13 0.01 250)" />
          </g>
        </g>

        <rect x="146" y="40" width="156" height="224" rx="12" class="fc" filter={sh} />
        {["M", "T", "W", "T", "F"].map((d, c) => (
          <text x={188.5 + c * 23} y="62" text-anchor="middle" class="sv-lbl">{d}</text>
        ))}
        {[0, 1, 2].map((r) => (
          <g>
            <text x="156" y={96 + r * 48} class="sv-lbl">{`B${r + 1}`}</text>
            {r > 0 && <path d={`M154 ${70 + r * 48} H294`} class="sl" />}
          </g>
        ))}
        <path d="M154 70 H294" class="sl" />
        {bayBlocks.map((b) => (
          b.n ? (
            <g>
              <rect x={b.x + 0.5} y={b.y + 0.5} width={b.w - 1} height="35" rx="5" fill="none" stroke-dasharray="3 3" style="stroke:oklch(0.5 0.02 250)" />
              <g class={`a aub-new aub-d${b.k}`}>
                <rect x={b.x} y={b.y} width={b.w} height="36" rx="5" class="fa" />
                <rect x={b.x + 5} y={b.y + 8} width={Math.max(8, b.w - 12)} height="4" rx="2" fill="#fff" opacity=".9" />
                <rect x={b.x + 5} y={b.y + 16} width={Math.max(6, b.w - 18)} height="4" rx="2" fill="#fff" opacity=".55" />
              </g>
            </g>
          ) : (
            <g>
              <rect x={b.x} y={b.y} width={b.w} height="36" rx="5" class="fs" />
              <rect x={b.x + 5} y={b.y + 8} width={b.w - 12} height="4" rx="2" style="fill:oklch(0.58 0.02 250)" />
              <rect x={b.x + 5} y={b.y + 16} width={Math.max(6, b.w - 24)} height="4" rx="2" style="fill:oklch(0.52 0.02 250)" />
            </g>
          )
        ))}
        <text x="156" y="238" class="sv-lbl">BOOKED</text>
        <rect x="156" y="245" width="134" height="6" rx="3" class="fl" />
        <rect x="156" y="245" width="134" height="6" rx="3" class="fa a aub-bar" />
      </g>
    )}

    {/* ───────────────────── Auto repair · inspection follow-up ───────────────────── */}
    {id === "auto-followup" && (
      <g>
        <text class="sv-lbl" x="20" y="26">INSPECTION / FOLLOW-UP</text>
        <rect x="24" y="44" width="152" height="216" rx="12" class="fc" filter={sh} />
        <rect x="78" y="37" width="44" height="14" rx="5" style="fill:oklch(0.8 0.012 250)" />
        <rect x="92" y="41" width="16" height="5" rx="2.5" class="fc" />
