<style is:global>
  /* ── Base: identical copy of ServiceVisual's shared rules (keep in sync) ── */
  /* ── Root + tints ─────────────────────────────────────────── */
  .sv {
    --sv-ink: oklch(0.22 0.02 250);
    --sv-mute: #414b56;
    --sv-line: oklch(0.88 0.01 250);
    --sv-soft: oklch(0.925 0.008 250);
    --sv-card: #fff;
    --sv-acc: #0072bc;
    --sv-bg: oklch(0.985 0.004 250);
    --sv-sh1: 0.06;
    --sv-sh2: 0.08;
    --sv-d: 6s;
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 8 / 7;
    overflow: hidden;
    border-radius: inherit;
    background: var(--sv-bg);
    color: var(--sv-ink);
    isolation: isolate;
  }
  .sv > svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .sv.sv--t-blue { --sv-bg: oklch(0.95 0.025 245); }
  .sv.sv--t-sand { --sv-bg: oklch(0.95 0.02 80); }
  .sv.sv--t-sage { --sv-bg: oklch(0.95 0.02 150); }
  .sv.sv--t-paper { --sv-bg: oklch(0.985 0.004 250); }
  .sv.sv--dark {
    --sv-bg: oklch(0.24 0.02 250);
    --sv-ink: oklch(0.95 0.006 250);
    --sv-mute: oklch(0.74 0.015 250);
    --sv-line: oklch(0.37 0.02 250);
    --sv-soft: oklch(0.43 0.02 250);
    --sv-card: oklch(0.3 0.022 250);
    --sv-acc: oklch(0.68 0.14 247);
    --sv-sh1: 0.25;
    --sv-sh2: 0.35;
  }
  .sv .sv-sh1 { flood-opacity: var(--sv-sh1); }
  .sv .sv-sh2 { flood-opacity: var(--sv-sh2); }

  /* ── Paint helpers ────────────────────────────────────────── */
  .sv .fc { fill: var(--sv-card); }
  .sv .fs { fill: var(--sv-soft); }
  .sv .fl { fill: var(--sv-line); }
  .sv .fi { fill: var(--sv-ink); }
  .sv .fm { fill: var(--sv-mute); }
  .sv .fa { fill: var(--sv-acc); }
  .sv .sl { fill: none; stroke: var(--sv-line); }
  .sv .sa { fill: none; stroke: var(--sv-acc); }
  .sv .sm { fill: none; stroke: var(--sv-mute); }
  .sv text { font-family: inherit; }
  .sv .sv-lbl,
  .sv .sv-num {
    font-family: ui-monospace, "SFMono-Regular", "Cascadia Mono", Menlo, Consolas, monospace;
    font-size: 9px;
    letter-spacing: 0.12em;
    fill: var(--sv-mute);
    opacity: 0.85;
  }
  .sv .sv-num { font-size: 10px; letter-spacing: 0.04em; fill: var(--sv-ink); }

  /* ── Animation engine: paused until hovered or [data-sv-play] ─ */
  .sv .a {
    animation-duration: var(--sv-d);
    animation-iteration-count: infinite;
    animation-timing-function: cubic-bezier(0.45, 0, 0.2, 1);
    animation-fill-mode: both;
    animation-play-state: paused;
    transform-box: fill-box;
    transform-origin: center;
  }
  .sv:hover .a,
  .sv[data-sv-play] .a,
  [data-sv-play] .sv .a {
    animation-play-state: running;
  }
  /* At rest, hold the first keyframe (the finished still) through a long delay, so a visual
     always returns to its still when hover ends instead of freezing mid-loop. */
  .sv:not(:hover):not([data-sv-play]):not([data-sv-play] .sv) .a {
    animation-delay: 9999s !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .sv .a,
    .sv:hover .a,
    .sv[data-sv-play] .a,
    [data-sv-play] .sv .a {
      animation-play-state: paused !important;
      animation-delay: 9999s !important;
    }
  }

  /* shared keyframes */
  .sv .sv-rise { animation-name: sv-rise; }
  .sv .sv-pop { animation-name: sv-pop; }
  .sv .sv-flag { animation-name: sv-flag; }
  .sv .sv-flagpop { animation-name: sv-flagpop; }
  @keyframes sv-rise {
    0%, 6% { opacity: 1; transform: none; }
    11%, 18% { opacity: 0; transform: translateY(6px); }
    28%, 100% { opacity: 1; transform: none; }
  }
  @keyframes sv-pop {
    0%, 6% { opacity: 1; transform: none; }
    11%, 18% { opacity: 0; transform: scale(0.8); }
    28%, 100% { opacity: 1; transform: none; }
  }
  @keyframes sv-flag {
    0%, 8% { opacity: 1; }
    12%, 62% { opacity: 0; }
    70%, 100% { opacity: 1; }
  }
  @keyframes sv-flagpop {
    0%, 8% { opacity: 1; transform: none; }
    12%, 62% { opacity: 0; transform: scale(0.4); }
    70%, 100% { opacity: 1; transform: none; }
  }

  /* ═════════════════════ Industry scenes ═════════════════════
     Every selector is prefixed .sv.sv--<id>; keyframes are prefixed iv-. */

  /* gd-emergency */
  .sv.sv--gd-emergency { --sv-d: 6.5s; }
  .sv.sv--gd-emergency .gde-door { transform: translateY(-96px); animation-name: iv-gde-door; }
  .sv.sv--gd-emergency .gde-tile { animation-name: iv-gde-tile; }
  .sv.sv--gd-emergency .gde-ring { opacity: 0; animation-name: iv-gde-ring; }
