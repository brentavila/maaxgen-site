---
/**
 * Shared frame for an industry content block: the section, its tone (background),
 * the anchor id, and the eyebrow / h2 / intro header. Each block type passes its
 * own layout (`layout`) and renders its body in the default slot.
 *   layout "stacked": header above the body.
 *   layout "split":   header in a left column (sticky on desktop), body on the right.
 */
interface Props {
  id: string;
  type: string;
  eyebrow: string;
  heading: string;
  intro?: string;
  tone: "light" | "surface" | "dark";
  layout?: "stacked" | "split";
}

const { id, type, eyebrow, heading, intro, tone, layout = "stacked" } = Astro.props;
const headingId = `${id}-title`;
---

<section
  id={id}
  class={`ind-block ind-block--${type} ind-tone--${tone} ind-layout--${layout}`}
  aria-labelledby={headingId}
  data-block-type={type}
>
  <div class="container ind-block__inner">
    <header class="ind-block__head" data-reveal>
      <p class="ind-eyebrow">{eyebrow}</p>
      <h2 class="ind-block__title" id={headingId}>{heading}</h2>
      {intro && <p class="ind-block__intro">{intro}</p>}
    </header>
    <div class="ind-block__body">
      <slot />
    </div>
  </div>
</section>
