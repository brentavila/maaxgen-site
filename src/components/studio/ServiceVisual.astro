---
/**
 * ServiceVisual — one small, living diagram per MaaxGen service.
 *
 *   <ServiceVisual id="google-ads" uid="card" />
 *
 * - Root: <div class="sv sv--{id}" aria-hidden="true"> with one inline SVG (viewBox 320x280, 8:7).
 * - Every SVG id is suffixed with `uid` so the same visual can render more than once per page.
 * - Motion is CSS only and paused by default. It runs when an ancestor has [data-sv-play]
 *   or while the visual is hovered. Never animates under prefers-reduced-motion.
 * - The un-animated (paused, first-frame) state of every visual is its finished still.
 */
interface Props {
  id: string;
  uid?: string;
  /** google-ads only: replaces the typed search text (max 24 characters). */
  query?: string;
}

const { id, uid, query } = Astro.props;

const TINTS: Record<string, "blue" | "sand" | "sage" | "paper" | "dark"> = {
  "google-ads": "blue",
  "meta-ads": "sand",
  seo: "dark",
  "local-seo": "sage",
  websites: "paper",
  apps: "dark",
  "landing-pages": "sand",
  video: "dark",
  images: "sage",
  "music-audio": "blue",
  "ai-follow-up": "dark",
  "crm-automation": "paper",
};

const known = Object.prototype.hasOwnProperty.call(TINTS, id);
const tint = known ? TINTS[id] : "paper";
const u = String(uid ?? Math.random().toString(36).slice(2, 8)).replace(/[^a-zA-Z0-9_-]/g, "") || "x";
const idKey = String(id).replace(/[^a-zA-Z0-9_-]/g, "") || "x";
const ref = (n: string) => `sv-${n}-${idKey}-${u}`;
const url = (n: string) => `url(#${ref(n)})`;
const sh = url("sh");
const rootClass = `sv sv--${known ? id : "unknown"} sv--t-${tint}${tint === "dark" ? " sv--dark" : ""}`;

/* Deterministic data for waveforms and rulers */
const musicBars = Array.from({ length: 60 }, (_, i) => {
  const env = 0.3 + 0.7 * Math.abs(Math.sin(i * 0.55) * Math.sin(i * 0.11 + 0.5));
  const h = Math.round((6 + 50 * env) * 10) / 10;
  return { x: 40 + i * 4, h };
});
const audioBars = Array.from({ length: 87 }, (_, i) => {
  const h = Math.round((2 + 7 * Math.abs(Math.sin(i * 0.7) * Math.cos(i * 0.23 + 0.4))) * 10) / 10;
  return { x: 30 + i * 3, h };
});
const rulerTicks = Array.from({ length: 27 }, (_, i) => ({ x: 30 + i * 10, tall: i % 5 === 0 }));

/* google-ads search text. The default keeps the original geometry and keyframes; a custom
   query gets its own width (≈6.15 units per character) and a per-instance typing keyframe. */
const gaQuery = String(query ?? "").replace(/\s+/g, " ").trim().slice(0, 24).trim();
const gaCustom = id === "google-ads" && gaQuery !== "" && gaQuery !== "plumber near me";
const gaText = gaCustom ? gaQuery : "plumber near me";
const gaLen = gaCustom ? Math.max(1, Math.round(gaQuery.length * 6.15)) : 92;
const gaKf = `sv-ga-cover-${idKey}-${u}`;
const gaCss = gaCustom
  ? `.sv .ga-cover.${gaKf}{transform:translateX(${gaLen + 2}px);animation-name:${gaKf}}` +
    `@keyframes ${gaKf}{0%,6%{transform:translateX(${gaLen + 2}px);animation-timing-function:cubic-bezier(0.5,0,0.75,0)}` +
    `12%{transform:translateX(0)}16%{transform:translateX(0);animation-timing-function:steps(${gaQuery.length},end)}` +
    `42%,100%{transform:translateX(${gaLen + 2}px)}}`
  : "";

const heart =
  "M0 4.2 C-4.8 0.8 -6 -1.2 -6 -2.8 C-6 -4.6 -4.6 -6 -3 -6 C-1.6 -6 -0.6 -5.2 0 -4.2 C0.6 -5.2 1.6 -6 3 -6 C4.6 -6 6 -4.6 6 -2.8 C6 -1.2 4.8 0.8 0 4.2 Z";
const star =
  "M0 -6 L1.53 -2.1 L5.71 -1.85 L2.47 0.8 L3.53 4.85 L0 2.6 L-3.53 4.85 L-2.47 0.8 L-5.71 -1.85 L-1.53 -2.1 Z";
---
<div class={rootClass} aria-hidden="true">
  <svg viewBox="0 0 320 280" xmlns="http://www.w3.org/2000/svg" focusable="false" preserveAspectRatio="xMidYMid meet">
    <defs>
      <filter id={ref("sh")} x="-20%" y="-20%" width="140%" height="150%" color-interpolation-filters="sRGB">
        <feDropShadow class="sv-sh1" dx="0" dy="1" stdDeviation="0.8" flood-color="#0b1b2e" />
        <feDropShadow class="sv-sh2" dx="0" dy="6" stdDeviation="8" flood-color="#0b1b2e" />
      </filter>
      <filter id={ref("bl")} x="-10%" y="-10%" width="120%" height="120%">
        <feGaussianBlur stdDeviation="2.6" />
      </filter>
      <clipPath id={ref("c1")}>
        {id === "meta-ads" && <rect x="96" y="44" width="128" height="240" />}
        {id === "local-seo" && <rect x="20" y="40" width="186" height="206" rx="14" />}
        {id === "apps" && <rect x="104" y="26" width="112" height="236" rx="17" />}
        {id === "video" && <rect x="70" y="30" width="180" height="104" rx="8" />}
        {id === "images" && <rect x="68" y="46" width="184" height="158" rx="8" />}
        {id === "music-audio" && <rect class="a mu-prog" x="36" y="108" width="248" height="104" />}
      </clipPath>
    </defs>

    {/* ───────────────────────── 01 Google Ads ───────────────────────── */}
    {id === "google-ads" && (
      <g>
        <text class="sv-lbl" x="20" y="26">SEARCH / SPONSORED</text>
        <rect x="28" y="40" width="264" height="36" rx="18" class="fc" filter={sh} />
        <circle cx="48" cy="58" r="5.5" class="sm" stroke-width="1.6" />
        <path d="M52.2 62.2 L56.4 66.4" class="sm" stroke-width="1.6" stroke-linecap="round" />
        <text x="64" y="62" class="tx fi" font-size="11.5" font-weight="600" textLength={gaLen} lengthAdjust="spacingAndGlyphs">{gaText}</text>
        {!gaCustom && (
          <g class="a ga-cover">
            <rect x="63" y="46" width="122" height="24" class="fc" />
            <rect x="64" y="51.5" width="1.5" height="13" rx="0.75" class="fi a ga-caret" />
          </g>
        )}
        {gaCustom && (
          <g clip-path={url("gq")}>
            <style is:inline set:html={gaCss} />
            <clipPath id={ref("gq")}><rect x="28" y="40" width="264" height="36" rx="18" /></clipPath>
            <g class={`a ga-cover ${gaKf}`}>
              <rect x="63" y="46" width={gaLen + 30} height="24" class="fc" />
              <rect x="64" y="51.5" width="1.5" height="13" rx="0.75" class="fi a ga-caret" />
            </g>
          </g>
        )}

        <rect x="28" y="88" width="264" height="176" rx="14" class="fc" filter={sh} />
        <g class="a ga-row">
          <rect x="36" y="96" width="248" height="58" rx="10" class="fa a ga-hl" style="fill-opacity:.09" />
          <text x="48" y="113" class="tx fi" font-size="8.5" font-weight="700">Sponsored</text>
          <circle cx="100" cy="110" r="1.4" class="fm" />
          <rect x="106" y="107.5" width="54" height="5" rx="2.5" class="fs" />
          <rect x="48" y="120" width="152" height="8" rx="4" class="fs" />
          <rect x="48" y="120" width="152" height="8" rx="4" class="fa a ga-hl" />
          <rect x="48" y="134" width="204" height="5" rx="2.5" class="fs" />
          <rect x="48" y="143" width="132" height="5" rx="2.5" class="fs" />
        </g>
        <path d="M44 162 H276" class="sl" />
        <g class="a ga-row ga-d1">
          <circle cx="54" cy="177" r="6" class="fs" />
          <rect x="66" y="174" width="118" height="7" rx="3.5" class="fm" opacity=".45" />
          <rect x="48" y="190" width="210" height="5" rx="2.5" class="fs" />
          <rect x="48" y="199" width="160" height="5" rx="2.5" class="fs" />
        </g>
        <path d="M44 214 H276" class="sl" />
        <g class="a ga-row ga-d2">
          <circle cx="54" cy="229" r="6" class="fs" />
          <rect x="66" y="226" width="96" height="7" rx="3.5" class="fm" opacity=".45" />
          <rect x="48" y="242" width="190" height="5" rx="2.5" class="fs" />
          <rect x="48" y="251" width="118" height="5" rx="2.5" class="fs" />
        </g>
        <circle cx="186" cy="125" r="10" class="sa a ga-ring" stroke-width="1.5" />
        <g transform="translate(186 125)">
          <g class="a ga-cur">
            <path d="M0 0 L0 15 L4 11.5 L7 18 L9.6 16.9 L6.6 10.5 L11.6 10.5 Z" class="fi" stroke="#fff" stroke-width="1.2" stroke-linejoin="round" />
          </g>
        </g>
      </g>
    )}

    {/* ───────────────────────── 02 Meta Ads ───────────────────────── */}
    {id === "meta-ads" && (
      <g>
        <text class="sv-lbl" x="20" y="26">FEED / PROMOTED</text>
        <rect x="96" y="26" width="128" height="280" rx="22" class="fc" filter={sh} />
        <g clip-path={url("c1")}>
          <g class="a mt-feed">
            <rect x="104" y="-40" width="112" height="58" rx="8" class="fs" />
            <rect x="106" y="27" width="40" height="5" rx="2.5" class="fs" />
            <circle cx="113" cy="62" r="7" style="fill:oklch(0.86 0.05 75)" />
            <rect x="125" y="56" width="46" height="5" rx="2.5" class="fi" opacity=".8" />
            <text x="125" y="72" class="tx fm" font-size="7.5" font-weight="600">Sponsored</text>
            <circle cx="203" cy="61" r="1.3" class="fm" /><circle cx="207.5" cy="61" r="1.3" class="fm" /><circle cx="212" cy="61" r="1.3" class="fm" />

            <rect x="104" y="80" width="112" height="102" rx="8" style="fill:oklch(0.88 0.045 75)" />
            <circle cx="191" cy="102" r="11" style="fill:oklch(0.97 0.02 80)" />
            <ellipse cx="158" cy="166" rx="31" ry="6" style="fill:oklch(0.8 0.055 70)" />
            <rect x="150" y="101" width="16" height="13" rx="3" style="fill:oklch(0.3 0.02 250)" />
            <rect x="142" y="111" width="32" height="55" rx="8" style="fill:oklch(0.3 0.02 250)" />
            <rect x="142" y="130" width="32" height="12" style="fill:oklch(0.93 0.02 80)" />

            <g class="a mt-cta">
              <rect x="104" y="188" width="112" height="22" rx="7" class="fa" />
              <text x="160" y="202" text-anchor="middle" class="tx" font-size="8.5" font-weight="700" fill="#fff">Learn more</text>
            </g>
            <rect x="104" y="188" width="112" height="22" rx="7" class="sa a mt-ring" stroke-width="1.5" vector-effect="non-scaling-stroke" />

            <g transform="translate(112 226)"><path d={heart} class="fa a mt-like" /></g>
            <path d="M124 221.5 h10 a2 2 0 0 1 2 2 v5 a2 2 0 0 1 -2 2 h-6 l-3 2.6 v-2.6 h-1 a2 2 0 0 1 -2 -2 v-5 a2 2 0 0 1 2 -2 Z" class="sm" stroke-width="1.2" />
            <circle cx="186" cy="226" r="5.5" class="fs" stroke="#fff" stroke-width="1.5" />
            <circle cx="195" cy="226" r="5.5" style="fill:oklch(0.86 0.05 75)" stroke="#fff" stroke-width="1.5" />
            <circle cx="204" cy="226" r="5.5" class="fl" stroke="#fff" stroke-width="1.5" />
            <circle cx="213" cy="226" r="5.5" class="fa a mt-av" stroke="#fff" stroke-width="1.5" />

            <path d="M100 242 H220" class="sl" />
            <circle cx="113" cy="256" r="7" class="fs" />
            <rect x="125" y="253" width="50" height="5" rx="2.5" class="fs" />
            <rect x="104" y="270" width="112" height="60" rx="8" class="fs" />
          </g>
          <g transform="translate(112 222)">
            <path d={heart} class="fa a mt-fl" />
            <path d={heart} class="fa a mt-fl mt-d1" transform="translate(10 0) scale(.8)" />
            <path d={heart} class="fa a mt-fl mt-d2" transform="translate(-4 0) scale(.7)" />
          </g>
        </g>
        <rect x="144" y="32" width="32" height="7" rx="3.5" class="fi" opacity=".85" />
      </g>
    )}

    {/* ───────────────────────── 03 SEO ───────────────────────── */}
    {id === "seo" && (
      <g>
        <text class="sv-lbl" x="20" y="26">RANK / ORGANIC</text>
        <g class="a seo-list">
          {[1, 2, 3, 4, 5].map((n, i) => (
            <text x="36" y={62 + i * 38 + 19} text-anchor="middle" class="sv-num" opacity={n === 1 ? 1 : 0.6}>{String(n).padStart(2, "0")}</text>
          ))}
          <path d="M282 77 V229" class="sl" stroke-width="1.5" />
          {[0, 1, 2, 3, 4].map((i) => <circle cx="282" cy={77 + i * 38} r="2.2" class="fl" />)}
          <path d="M282 229 V77" class="sa a seo-rail" stroke-width="2" stroke-linecap="round" pathLength="1" style="stroke-dasharray:1 1" />

          {[
            { slot: 4, k: "f5", w: 120, w2: 84 },
            { slot: 3, k: "f4", w: 92, w2: 120 },
            { slot: 2, k: "f3", w: 138, w2: 96 },
            { slot: 1, k: "f2", w: 108, w2: 130 },
          ].map((r) => (
            <g transform={`translate(0 ${62 + r.slot * 38})`}>
              <g class={`a seo-${r.k}`}>
                <rect x="52" y="0" width="210" height="30" rx="8" class="fc" />
                <rect x="62" y="9" width="12" height="12" rx="3" class="fs" />
                <rect x="82" y="9" width={r.w} height="5" rx="2.5" class="fs" />
                <rect x="82" y="18" width={r.w2} height="4" rx="2" class="fl" />
              </g>
            </g>
          ))}
          <g transform="translate(0 62)">
            <g class="a seo-c">
              <rect x="52" y="0" width="210" height="30" rx="8" class="fa" style="fill-opacity:.16" />
              <rect x="52.5" y="0.5" width="209" height="29" rx="7.5" class="sa" stroke-opacity=".7" />
              <rect x="62" y="9" width="12" height="12" rx="3" class="fa" />
              <rect x="82" y="9" width="118" height="5" rx="2.5" class="fi" />
              <rect x="82" y="18" width="80" height="4" rx="2" class="fm" opacity=".6" />
              <path d="M238 18 L244 12 L250 18" class="sa" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              <circle cx="282" cy="15" r="4.5" class="fa" />
              <circle cx="282" cy="15" r="8" class="fa" style="fill-opacity:.2" />
            </g>
          </g>
        </g>
      </g>
    )}

    {/* ───────────────────────── 04 Local SEO ───────────────────────── */}
    {id === "local-seo" && (
      <g>
        <text class="sv-lbl" x="20" y="26">MAP / NEARBY</text>
        <rect x="20" y="40" width="186" height="206" rx="14" class="fc" filter={sh} />
        <g clip-path={url("c1")}>
          <rect x="20" y="40" width="186" height="206" style="fill:oklch(0.975 0.006 150)" />
          <rect x="74" y="140" width="66" height="56" rx="10" style="fill:oklch(0.9 0.05 150)" />
          <circle cx="92" cy="160" r="5" style="fill:oklch(0.84 0.06 150)" />
          <circle cx="118" cy="176" r="7" style="fill:oklch(0.84 0.06 150)" />
          <rect x="160" y="52" width="38" height="44" rx="6" style="fill:oklch(0.94 0.008 250)" />
          <rect x="26" y="122" width="28" height="44" rx="6" style="fill:oklch(0.94 0.008 250)" />
          <path d="M20 78 H206 M105 40 V246 M20 182 H206" fill="none" stroke-width="2.5" style="stroke:oklch(0.91 0.01 250)" />
          <path d="M20 112 H206 M60 40 V246 M150 40 V246 M20 236 L206 132" fill="none" stroke-width="9" stroke-linecap="round" style="stroke:oklch(0.93 0.008 250)" />
          <path d="M20 112 H206 M60 40 V246 M150 40 V246 M20 236 L206 132" fill="none" stroke="#fff" stroke-width="1" stroke-dasharray="4 5" />
        </g>
        <g transform="translate(105 112)">
          <ellipse cx="0" cy="0" rx="16" ry="6" class="sa a ls-pulse" stroke-width="1.4" vector-effect="non-scaling-stroke" />
          <ellipse cx="0" cy="0.5" rx="6.5" ry="2.3" class="fi a ls-shadow" style="fill-opacity:.2" />
          <g class="a ls-pin">
            <path d="M0 0 C-3 -7 -11 -12 -11 -21 A11 11 0 1 1 11 -21 C11 -12 3 -7 0 0 Z" class="fa" />
            <circle cx="0" cy="-21" r="4.2" fill="#fff" />
          </g>
        </g>

        <rect x="142" y="146" width="158" height="98" rx="12" class="fc" filter={sh} />
        <rect x="154" y="158" width="34" height="34" rx="8" style="fill:oklch(0.88 0.05 150)" />
        <path d="M162 185 V175 L171 168 L180 175 V185 Z" fill="#fff" />
        <rect x="168.5" y="178" width="5" height="7" style="fill:oklch(0.88 0.05 150)" />
        <rect x="198" y="162" width="74" height="7" rx="3.5" class="fi" opacity=".85" />
        <rect x="198" y="175" width="52" height="5" rx="2.5" class="fs" />
        <circle cx="201" cy="188" r="2.5" style="fill:oklch(0.62 0.09 150)" />
        <rect x="207" y="185.5" width="30" height="5" rx="2.5" class="fs" />
        {[0, 1, 2, 3, 4].map((i) => (
          <g transform={`translate(${160 + i * 16} 216)`}>
            <path d={star} class="sl" stroke-width="1" stroke-linejoin="round" />
            <path d={star} class={`fa a ls-star ls-d${i}`} />
          </g>
        ))}
        <rect x="244" y="213" width="44" height="6" rx="3" class="fs" />
        <rect x="154" y="230" width="134" height="1" class="fl" />
      </g>
    )}

    {/* ───────────────────────── 05 Websites ───────────────────────── */}
    {id === "websites" && (
      <g>
        <text class="sv-lbl" x="20" y="26">BUILD / LAYOUT</text>
        <rect x="24" y="38" width="272" height="226" rx="12" class="fc" filter={sh} />
        <circle cx="40" cy="52" r="3" class="fl" /><circle cx="50" cy="52" r="3" class="fl" /><circle cx="60" cy="52" r="3" class="fl" />
        <rect x="88" y="46" width="144" height="12" rx="6" class="fs" />
        <path d="M24 64.5 H296" class="sl" />
        <g class="sl" stroke-dasharray="3 3" style="stroke:oklch(0.84 0.015 250)">
          <rect x="36.5" y="74.5" width="247" height="15" rx="4" />
          <rect x="36.5" y="98.5" width="247" height="83" rx="6" />
          <rect x="36.5" y="192.5" width="77" height="61" rx="6" />
          <rect x="121.5" y="192.5" width="77" height="61" rx="6" />
          <rect x="206.5" y="192.5" width="77" height="61" rx="6" />
        </g>
        <g class="a sv-rise">
          <rect x="38" y="76" width="12" height="12" rx="3.5" class="fi" />
          <rect x="56" y="80" width="30" height="4" rx="2" class="fi" opacity=".75" />
          <rect x="176" y="80" width="18" height="4" rx="2" class="fs" />
          <rect x="200" y="80" width="18" height="4" rx="2" class="fs" />
          <rect x="224" y="80" width="18" height="4" rx="2" class="fs" />
          <rect x="250" y="76" width="32" height="12" rx="6" class="fi" />
        </g>
        <g class="a sv-rise wb-d1">
          <rect x="40" y="106" width="116" height="10" rx="5" class="fi" />
          <rect x="40" y="121" width="88" height="10" rx="5" class="fi" />
          <rect x="40" y="139" width="118" height="5" rx="2.5" class="fs" />
          <rect x="40" y="148" width="92" height="5" rx="2.5" class="fs" />
        </g>
        <rect x="40" y="161" width="52" height="15" rx="7.5" class="fa a sv-pop wb-d6" />
        <g class="a sv-rise wb-d2">
          <rect x="170" y="100" width="112" height="80" rx="7" style="fill:oklch(0.93 0.03 245)" />
          <circle cx="252" cy="122" r="9" fill="#fff" />
          <path d="M170 168 L198 142 L218 158 L236 146 L282 176 V173 A7 7 0 0 1 275 180 H177 A7 7 0 0 1 170 173 Z" style="fill:oklch(0.84 0.05 245)" />
        </g>
        {[0, 1, 2].map((i) => (
          <g class={`a sv-rise wb-d${3 + i}`}>
            <rect x={38 + i * 85} y="194" width="74" height="58" rx="6" style="fill:oklch(0.97 0.005 250)" />
            <rect x={46 + i * 85} y="202" width="12" height="12" rx="3.5" class="fs" />
            <rect x={46 + i * 85} y="222" width="42" height="5" rx="2.5" class="fi" opacity=".7" />
            <rect x={46 + i * 85} y="232" width="54" height="4" rx="2" class="fs" />
            <rect x={46 + i * 85} y="240" width="36" height="4" rx="2" class="fs" />
          </g>
        ))}
      </g>
    )}

    {/* ───────────────────────── 06 Apps ───────────────────────── */}
    {id === "apps" && (
      <g>
        <text class="sv-lbl" x="20" y="26">APP / FLOW</text>
        <rect x="98" y="20" width="124" height="248" rx="22" style="fill:oklch(0.15 0.015 250)" filter={sh} />
        <rect x="98.5" y="20.5" width="123" height="247" rx="21.5" fill="none" style="stroke:oklch(0.42 0.02 250)" />
        <g clip-path={url("c1")}>
          <rect x="104" y="26" width="112" height="236" fill="#f7f9fb" />
          <g class="a ap-list">
            <rect x="114" y="48" width="54" height="8" rx="4" fill="#1d2733" />
            <rect x="114" y="64" width="92" height="13" rx="6.5" fill="#e9edf2" />
            <rect x="106" y="118" width="108" height="32" rx="8" fill="#0072BC" class="a ap-hl" fill-opacity=".1" />
            {[0, 1, 2, 3].map((i) => (
              <g>
