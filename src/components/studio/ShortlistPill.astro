---
/**
 * Floating "Your shortlist" pill. Visible only while the shortlist has at
 * least one service. Opens the plan dialog via [data-plan-open].
 */
---

<button type="button" class="shortlist-pill" data-plan-open aria-hidden="true" tabindex="-1">
  <span class="shortlist-pill__label">Your shortlist</span>
  <span class="shortlist-pill__count" data-shortlist-count>0</span>
  <span class="shortlist-pill__cta">Get my plan <span aria-hidden="true">→</span></span>
</button>

<script>
  import { getShortlist, onShortlistChange } from "../../lib/shortlist";

  const pill = document.querySelector<HTMLElement>(".shortlist-pill");
  const notice = document.getElementById("cookie-notice");

  if (pill) {
    const setVisible = (ids: string[]) => {
      const on = ids.length > 0;
      pill.classList.toggle("is-visible", on);
      pill.setAttribute("aria-hidden", on ? "false" : "true");
      pill.tabIndex = on ? 0 : -1;
    };
    setVisible(getShortlist());
    onShortlistChange(setVisible);

    // Sit above the cookie notice while it is showing.
    const lift = () => {
      const showing = notice && !notice.hidden;
      const rect = showing ? notice.getBoundingClientRect() : null;
      const px = rect ? Math.max(0, window.innerHeight - rect.top) : 0;
      // (the pill's own 1rem base offset already provides the gap)
      pill.style.setProperty("--shortlist-pill-lift", px + "px");
    };
    lift();
    window.addEventListener("resize", lift);
    window.addEventListener("maaxgen:cookie-notice-show", lift);
    window.addEventListener("maaxgen:cookie-notice-dismiss", lift);
    if (notice && "ResizeObserver" in window) new ResizeObserver(lift).observe(notice);
  }
</script>

<style is:global>
  .shortlist-pill {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: calc(max(1rem, env(safe-area-inset-bottom)) + var(--shortlist-pill-lift, 0px));
    z-index: 90;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.9rem 0.55rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-slate);
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    box-shadow:
      0 1px 2px oklch(0.3 0.03 250 / 0.08),
      0 8px 24px oklch(0.3 0.03 250 / 0.14);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.75rem);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      visibility 0s linear 0.25s;
  }
  .shortlist-pill.is-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  .shortlist-pill:hover {
    border-color: var(--color-brand);
  }
  .shortlist-pill:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }
  .shortlist-pill__count {
    display: inline-grid;
    place-items: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding-inline: 0.35rem;
    border-radius: 999px;
    background: var(--color-brand);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .shortlist-pill__cta {
    color: var(--color-brand);
  }
  @media (prefers-reduced-motion: reduce) {
    .shortlist-pill,
    .shortlist-pill.is-visible {
      transition: none;
      transform: none;
    }
  }
</style>
