---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  description="The page you requested could not be found on MaaxGen."
>
  <section class="page-hero">
    <div class="container" style="max-width: 40rem;">
      <p class="eyebrow">404</p>
      <h1>This page is not here.</h1>
      <p class="lead">
        The link may be outdated or the address may have been typed wrong. Try one of the pages
        below.
      </p>
      <div class="cta-row">
        <a class="btn btn--primary" href="/">Go home</a>
        <a class="btn btn--secondary" href="/services">View services</a>
        <a class="btn btn--secondary" href="/contact">Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>
