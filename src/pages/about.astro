---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getImage } from "astro:assets";
import "../styles/founder.css";
import FounderImage from "../components/founder/FounderImage.astro";
import { getFounderImage, hasFounderDeskVideo } from "../components/founder/founder-assets";

// Each founder placement renders only when its image exists in src/assets/founder/.
const portrait = getFounderImage("founder-portrait");
const deskStill = getFounderImage("founder-desk");
const clientImg = getFounderImage("founder-client");
const deskPoster =
  hasFounderDeskVideo() && deskStill
    ? await getImage({ src: deskStill, width: 1000, format: "webp", quality: 72 })
    : undefined;

const principles = [
  {
    index: "01",
    title: "One plan beats scattered tactics",
    text: "Growth work improves when strategy, ads, creative, reporting, and AI support share the same priorities.",
  },
  {
    index: "02",
    title: "Plain language builds trust",
    text: "Owners should know what is happening, why it matters, and what decision comes next without decoding agency jargon.",
  },
  {
    index: "03",
    title: "AI should save time, not replace judgment",
    text: "Automation is useful when it helps teams brief, draft, organize, and decide faster with human review intact.",
  },
];
---
<BaseLayout title="About" description="About MaaxGen, a bundled marketing, advertising, and AI agency for local and e-commerce SMBs.">
  <section class="page-hero page-hero--accent">
    <div class:list={["container split-block", portrait && "founder-hero"]}>
      <div class={portrait ? "founder-hero__text" : undefined}>
        <p class="eyebrow">About MaaxGen</p>
        <h1>Built for owners who need a growth partner, not another vendor to manage</h1>
        <p class="lead">
          MaaxGen helps local and e-commerce SMBs connect the work that often gets split apart: positioning, creative, paid media, reporting, and practical AI workflows.
        </p>
      </div>
      {portrait && (
      <figure class="founder-figure founder-hero__figure">
        <div class="founder-figure__frame">
          <FounderImage
            src={portrait}
            alt="Brent Avila, founder of MaaxGen, standing at his desk beside a reporting dashboard"
            widths={[320, 480, 640]}
            sizes="(min-width: 56rem) 24rem, (min-width: 40rem) 22rem, calc(100vw - 2rem)"
            position="85% 18%"
            eager
          />
        </div>
        <figcaption>Brent Avila, Founder</figcaption>
      </figure>
      )}
      <div class:list={["proof-panel", portrait && "founder-hero__panel"]}>
        <h2>Our role</h2>
        <p>
          We translate goals into a working growth system, then keep the pieces moving together so the business is not left coordinating disconnected specialists.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class:list={["container split-block", deskPoster && "founder-story"]}>
      <div class={deskPoster ? "founder-story__head" : undefined}>
        <p class="eyebrow">Agency story</p>
        <h2>Strategy, execution, and AI under one roof</h2>
      </div>
      <div class={deskPoster ? "founder-story__body" : undefined}>
        <p>
          Small teams are asked to move like large marketing departments. They need better offers, sharper creative, paid campaigns, content, follow-up, and reporting, all while running the business.
        </p>
        <p>
          MaaxGen was shaped around that reality. The bundle keeps strategic planning close to execution, so ads do not drift away from the offer, creative does not miss the campaign, and AI tools support the workflow instead of becoming another thing to manage.
        </p>
      </div>
      {deskPoster && (
      <div class="founder-photo founder-story__media">
        <video
          muted
          loop
          playsinline
          preload="none"
          poster={deskPoster.src}
          aria-hidden="true"
          tabindex="-1"
          width="1176"
          height="784"
          data-founder-video
        >
          <source src="/video/founder/founder-desk-broll.mp4" type="video/mp4" />
        </video>
      </div>
      )}
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">What we believe</p>
        <h2>Practical growth principles</h2>
      </div>
      <div class="pillar-list">
        {principles.map((item) => (
          <article class="pillar">
            <span class="pillar__index" aria-hidden="true">{item.index}</span>
            <div class="pillar__body">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class:list={["container split-block", clientImg && "founder-final"]}>
      <div class={clientImg ? "founder-final__head" : undefined}>
        <p class="eyebrow">Who we serve</p>
        <h2>Local presence and online revenue both need coordination</h2>
      </div>
      <div class:list={["audience-list", clientImg && "founder-final__list"]}>
        <article>
          <h3>Local businesses</h3>
          <p>Service areas, reputation, offers, and booking paths need to line up so every campaign supports real customer intent.</p>
        </article>
        <article>
          <h3>E-commerce brands</h3>
          <p>Catalog decisions, creative refreshes, email, paid social, and landing pages need one rhythm so spend is not wasted.</p>
        </article>
      </div>
      {clientImg && (
      <div class="founder-photo founder-final__media">
        <FounderImage
          src={clientImg}
          alt="Brent Avila talking through a plan with a client at a meeting table"
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 56rem) 32rem, calc(100vw - 2rem)"
          position="36% 30%"
        />
      </div>
      )}
      <div class:list={["cta-row", clientImg && "founder-final__cta"]}>
        <a class="btn btn--primary" href="/contact/" data-track-cta="about-final">Book a call</a>
        <a class="btn btn--secondary" href="/case-studies/">View case studies</a>
      </div>
    </div>
  </section>

  {deskPoster && (
  <script is:inline>
    const video = document.querySelector("[data-founder-video]");
    if (video && "IntersectionObserver" in window) {
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
      let inView = false;
      const sync = () => {
        if (inView && !reduce.matches) {
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      };
      new IntersectionObserver(
        ([entry]) => {
          inView = entry.isIntersecting;
          sync();
        },
        { threshold: 0.35 }
      ).observe(video);
      reduce.addEventListener("change", sync);
    }
  </script>
  )}
</BaseLayout>
