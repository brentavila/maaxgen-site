---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.localeCompare(a.data.publishDate));

const [featuredPost, ...remainingPosts] = posts;
const topics = [...new Set(posts.flatMap((post) => [post.data.category, ...post.data.tags]))].slice(0, 6);

function formatDate(value: string) {
  return new Date(`${value}T00:00:00`).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}
---

<BaseLayout title="Blog" description="Practical MaaxGen field notes on growth strategy, advertising, conversion, and useful AI.">
  <section class="phase-hero phase-hero--blog">
    <div class="container phase-hero__grid">
      <div>
        <p class="hero-kicker">MaaxGen field notes</p>
        <h1>Clear thinking for <span>better growth decisions.</span></h1>
        <p class="lead">
          Practical guidance for owners deciding what to fix, test, or ignore next.
        </p>
      </div>
      <div class="blog-compass" aria-label="MaaxGen articles connect strategy, demand, conversion, and operations">
        <span>Strategy</span>
        <span>Demand</span>
        <strong>Useful<br />growth</strong>
        <span>Conversion</span>
        <span>Operations</span>
      </div>
    </div>
  </section>

  {topics.length > 0 && (
    <div class="topic-strip">
      <div class="container topic-strip__inner">
        <span>Explore:</span>
        {topics.map((topic) => <span>{topic}</span>)}
      </div>
    </div>
  )}

  <section class="section editorial-section">
    <div class="container">
      {featuredPost ? (
        <>
          <a class="featured-article" href={`/blog/${featuredPost.id}`} data-reveal>
            <div class="featured-article__visual" aria-hidden="true">
              <span>01</span>
              <div>
                <i></i><i></i><i></i>
              </div>
              <strong>One<br />connected<br />idea</strong>
            </div>
            <div class="featured-article__content">
              <p>{featuredPost.data.category} / {formatDate(featuredPost.data.publishDate)}</p>
              <h2>{featuredPost.data.title}</h2>
              <p>{featuredPost.data.description}</p>
              <span>Read the field note <i aria-hidden="true">→</i></span>
            </div>
          </a>

          {remainingPosts.length > 0 && (
            <div class="article-grid">
              {remainingPosts.map((post, index) => (
                <a href={`/blog/${post.id}`} data-reveal style={`--reveal-delay: ${index * 0.08}s`}>
                  <p>{post.data.category} / {formatDate(post.data.publishDate)}</p>
                  <h2>{post.data.title}</h2>
                  <span>Read article <i aria-hidden="true">→</i></span>
                </a>
              ))}
            </div>
          )}
        </>
      ) : (
        <div class="editorial-empty">
          <span>Notes in progress</span>
          <h2>The first field notes are being prepared.</h2>
          <p>Useful, decision-ready articles will live here. No trend chasing.</p>
        </div>
      )}
    </div>
  </section>

  <section class="editorial-promise">
    <div class="container editorial-promise__grid">
      <div data-reveal>
        <p class="eyebrow">Our editorial filter</p>
        <h2>If it does not help an owner make a decision, it does not get published.</h2>
      </div>
      <ol>
        <li><span>01</span><p>Explain the <strong>why</strong></p></li>
        <li><span>02</span><p>Connect advice to a <strong>business outcome</strong></p></li>
        <li><span>03</span><p>Leave the reader with a <strong>next move</strong></p></li>
      </ol>
    </div>
  </section>

  <section class="home-final-cta">
    <div class="container home-final-cta__inner" data-reveal>
      <p>Prefer advice tied to your actual business?</p>
      <h2>Bring the context. We’ll help identify what deserves attention first.</h2>
      <a class="btn btn--primary" href="/contact">Start a conversation <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
