---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
  const studies = await getCollection("caseStudies");
  return studies.map((study) => ({ params: { slug: study.id } }));
}

const { slug } = Astro.params;
const entry = await getEntry("caseStudies", slug!);
if (!entry) return Astro.redirect("/case-studies");

const { Content } = await render(entry);
const { data } = entry;
const industryLabel = data.industry === "local" ? "Local business" : "E-commerce";
---

<BaseLayout title={data.title} description={data.summary}>
  <section class="case-detail-hero">
    <div class="container case-detail-hero__grid">
      <div>
        <a class="case-detail-hero__back" href="/case-studies">← All examples</a>
        <p class="hero-kicker">Illustrative engagement / {industryLabel}</p>
        <h1>{data.title}</h1>
        <p class="lead">{data.summary}</p>
      </div>
      <aside class="case-detail-snapshot" aria-label="Engagement snapshot">
        <span>Outcome</span>
        <strong>{data.outcome}</strong>
        <ul>
          {data.services.map((service) => <li>{service}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <div class="case-detail-disclosure">
    <div class="container">
      Illustrative example for demonstrating process and scope. Replace with approved client work
      and verified metrics before presenting as a documented result.
    </div>
  </div>

  <section class="section case-detail-section">
    <div class="container case-detail-layout">
      <aside class="case-detail-nav">
        <p>Engagement map</p>
        <ol>
          <li><span>01</span>Context</li>
          <li><span>02</span>Challenge</li>
          <li><span>03</span>Connected work</li>
          <li><span>04</span>Result</li>
        </ol>
      </aside>
      <article class="prose case-study-body case-detail-body">
        <Content />
      </article>
    </div>
  </section>

  <section class="story-principles">
    <div class="container story-principles__grid">
      <div data-reveal>
        <p class="eyebrow">The connected layer</p>
        <h2>What stayed aligned throughout the engagement.</h2>
      </div>
      <ol>
        <li><span>01</span><p>Strategy and offer decisions</p></li>
        <li><span>02</span><p>Campaign creative and landing copy</p></li>
        <li><span>03</span><p>Channel testing, follow-up, and reporting</p></li>
      </ol>
    </div>
  </section>

  <section class="home-final-cta">
    <div class="container home-final-cta__inner" data-reveal>
      <p>Your business will have a different starting point.</p>
      <h2>Let’s find the first move that makes the whole system stronger.</h2>
      <a class="btn btn--primary" href="/contact">Start your conversation <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
