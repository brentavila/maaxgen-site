---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const studies = (await getCollection("caseStudies")).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured)
);
---

<BaseLayout
  title="Case studies"
  description="Example MaaxGen engagements showing how strategy, creative, paid media, and practical AI work together."
>
  <section class="phase-hero phase-hero--stories">
    <div class="container phase-hero__grid">
      <div>
        <p class="hero-kicker">Example engagements</p>
        <h1>See the whole system, <span>not one isolated win.</span></h1>
        <p class="lead">
          These example engagements show how coordinated strategy, creative, media, and follow-up
          solve different growth problems.
        </p>
      </div>
      <div class="story-blueprint" aria-label="A case study moves from challenge through connected work to business outcome">
        <div><span>01</span><strong>Business context</strong><small>What was getting in the way?</small></div>
        <i aria-hidden="true">↓</i>
        <div><span>02</span><strong>Connected work</strong><small>What changed across the system?</small></div>
        <i aria-hidden="true">↓</i>
        <div><span>03</span><strong>Business outcome</strong><small>What became clearer or stronger?</small></div>
      </div>
    </div>
  </section>

  <section class="section story-index-section">
    <div class="container">
      <div class="story-index-heading" data-reveal>
        <p class="eyebrow">Two buying journeys</p>
        <h2>Different businesses. The same standard of accountability.</h2>
      </div>
      <div class="story-showcase">
        {studies.map((study, index) => (
          <article class:list={["story-showcase__item", index % 2 === 1 && "story-showcase__item--dark"]} data-reveal>
            <div class="story-showcase__topline">
              <span>Example {String(index + 1).padStart(2, "0")}</span>
              <span>{study.data.industry === "local" ? "Local business" : "E-commerce"}</span>
            </div>
            <div class="story-showcase__content">
              <p>{study.data.client}</p>
              <h2>{study.data.title}</h2>
              <p class="story-showcase__summary">{study.data.summary}</p>
              <div class="story-showcase__outcome">
                <span>Outcome</span>
                <strong>{study.data.outcome}</strong>
              </div>
            </div>
            <div class="story-showcase__footer">
              <ul>
                {study.data.services.slice(0, 3).map((service) => <li>{service}</li>)}
              </ul>
              <a href={`/case-studies/${study.id}`} aria-label={`Read ${study.data.title}`}>
                Read example <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
      <p class="example-disclosure" data-reveal>
        These are illustrative engagements used to show MaaxGen’s process and scope. Approved
        client metrics and stories will replace them as they become available.
      </p>
    </div>
  </section>

  <section class="story-principles">
    <div class="container story-principles__grid">
      <div data-reveal>
        <p class="eyebrow">What we look for</p>
        <h2>A result is only useful if you can explain how it happened.</h2>
      </div>
      <ol>
        <li data-reveal><span>01</span><p><strong>Business signal</strong> before platform noise</p></li>
        <li data-reveal><span>02</span><p><strong>Connected execution</strong> before channel credit</p></li>
        <li data-reveal><span>03</span><p><strong>Repeatable learning</strong> before a lucky spike</p></li>
      </ol>
    </div>
  </section>

  <section class="home-final-cta">
    <div class="container home-final-cta__inner" data-reveal>
      <p>Your growth stack does not need to be tidy before we talk.</p>
      <h2>Bring us the friction. We’ll help find the first connected win.</h2>
      <a class="btn btn--primary" href="/contact">Book a strategy call <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
