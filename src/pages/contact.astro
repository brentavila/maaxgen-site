---
import BaseLayout from "../layouts/BaseLayout.astro";
import SmsConsent from "../components/forms/SmsConsent.astro";
import Honeypot from "../components/forms/Honeypot.astro";
import PromoNote from "../components/promo/PromoNote.astro";
import "../styles/founder.css";
import FounderImage from "../components/founder/FounderImage.astro";
import { getFounderImage } from "../components/founder/founder-assets";

const founderPhone = getFounderImage("founder-phone");

---

<BaseLayout title="Contact" description="Tell MaaxGen where growth feels disconnected and start a focused strategy conversation.">
  <section class="contact-stage">
    <div class="container contact-stage__grid">
      <div class="contact-stage__intro">
        <p class="hero-kicker">Start with the real problem</p>
        <h1>Tell us where growth feels <span>disconnected.</span></h1>
        <p class="lead">
          You do not need a polished brief. Share the goal, the friction, and what you want off your
          plate.
        </p>
        <ol class="contact-next">
          <li><span>01</span><div><strong>We review the context</strong><small>Business, goals, current channels, and urgency.</small></div></li>
          <li><span>02</span><div><strong>We find the first leverage point</strong><small>No generic audit or prewritten pitch.</small></div></li>
          <li><span>03</span><div><strong>You get a clear next step</strong><small>A fit recommendation, useful direction, or an honest no.</small></div></li>
        </ol>
        <p class="contact-stage__note">Typical response: within one business day.</p>
        {founderPhone && (
        <figure class="founder-contact">
          <div class="founder-photo founder-contact__photo">
            <FounderImage
              src={founderPhone}
              alt="Brent Avila, founder of MaaxGen, smiling"
              widths={[176, 264]}
              sizes="5.5rem"
              position="50% 40%"
            />
          </div>
          <figcaption>Your message comes to Brent, not a ticket queue.</figcaption>
        </figure>
        )}
        <p class="contact-stage__grader-link">
          Not sure where the friction is? <a href="/ad-account-grader/">Grade your ads first</a>.
        </p>
      </div>

      <div class="contact-stage__form-wrap">
        <div class="contact-form-heading">
          <span>Strategy conversation</span>
          <h2 data-contact-form-title>What are you trying to grow?</h2>
          <p>Required fields are kept short. Helpful context makes the first reply more useful.</p>
          <div class="contact-grader-context" data-grader-context hidden>
            <strong data-grader-context-title>Your ad grader result is attached.</strong>
            <p data-grader-context-copy>We will use it as the starting point for this conversation.</p>
          </div>
        </div>

        <form id="contact-form" class="form phase-contact-form" action="/api/lead" method="post" data-lead-form="contact">
          <Honeypot />
          <input type="hidden" name="lead-source" value="contact-page" />
          <input type="hidden" name="grader-grade" value="" />
          <input type="hidden" name="grader-score" value="" />
          <input type="hidden" name="grader-industry" value="" />
          <input type="hidden" name="grader-frustration" value="" />
          <div class="contact-interest" data-shortlist-filled hidden>
            <p class="contact-interest__title">Services you are interested in</p>
            <div class="shortlist-chips" data-shortlist-chips></div>
          </div>
          <div class="field-grid">
            <div>
              <label for="name">Name</label>
              <input id="name" name="name" type="text" required autocomplete="name" />
            </div>
            <div>
              <label for="email">Email</label>
              <input id="email" name="email" type="email" required autocomplete="email" />
            </div>
          </div>
          <div class="field-grid">
            <div>
              <label for="phone">Phone <span class="field-optional">(optional)</span></label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
            </div>
            <div>
              <label for="business-type">Business type</label>
              <select id="business-type" name="business-type">
                <option value="">Select one</option>
                <option value="local">Local business</option>
                <option value="ecommerce">E-commerce</option>
                <option value="both">Local and e-commerce</option>
              </select>
            </div>
          </div>

          <label for="message">Where is the friction?</label>
          <textarea
            id="message"
            name="message"
            required
            placeholder="Goals, current channels, timeline, and what you want off your plate"
          ></textarea>

          <SmsConsent />

          <PromoNote />
          <button type="submit" class="btn btn--primary phase-contact-form__submit">
            Send the context <span aria-hidden="true">→</span>
          </button>
          <p class="form-status" id="form-status" role="alert" hidden></p>
          <p class="form-legal">
            By submitting this form you agree to our <a href="/privacy/">Privacy Policy</a> and
            <a href="/terms/">Terms &amp; Conditions</a>. Mobile information and SMS consent are
            never shared or sold to third parties for marketing.
          </p>
        </form>

        <div id="form-success" class="phase-form-success" role="status" tabindex="-1" hidden>
          <span aria-hidden="true">✓</span>
          <h2>We have your message.</h2>
          <p>We will review the context and follow up with a useful next step or booking link.</p>
          <a class="btn btn--secondary" href="/services/">Explore the growth system</a>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-fit-strip">
    <div class="container contact-fit-strip__grid">
      <p>What makes a useful first conversation</p>
      <div><span>01</span><strong>A real business goal</strong><small>Not a vanity metric target</small></div>
      <div><span>02</span><strong>Honest friction</strong><small>What is slow, unclear, or disconnected</small></div>
      <div><span>03</span><strong>Room to improve</strong><small>No expectation of overnight magic</small></div>
    </div>
  </section>

  <script>
    import { submitLead } from "../lib/tracking";
    import { splitName, watchLeadForm } from "../lib/lead-form";
    import { SMS_CONSENT_VERSION, SMS_MARKETING_CONSENT, SMS_TRANSACTIONAL_CONSENT } from "../lib/sms-consent";

    const form = document.getElementById("contact-form");
    const successBox = document.getElementById("form-success");
    const statusEl = document.getElementById("form-status");

    if (form) {
      const params = new URLSearchParams(window.location.search);
      let graderResult = null;

      if (params.get("source") === "ad-account-grader") {
        graderResult = {
          source: "ad-account-grader",
          grade: params.get("grade") || "",
          score: params.get("score") || "",
          industry: params.get("industry") || "",
          frustration: params.get("frustration") || "",
        };
      } else {
        try {
          const stored = window.sessionStorage.getItem("maaxgen-ad-grader-result");
          if (stored) graderResult = JSON.parse(stored);
        } catch {}
      }

      if (graderResult && graderResult.grade && graderResult.score) {
        const contextBox = document.querySelector("[data-grader-context]");
        const contextTitle = document.querySelector("[data-grader-context-title]");
        const contextCopy = document.querySelector("[data-grader-context-copy]");
        const formTitle = document.querySelector("[data-contact-form-title]");
        const message = form.querySelector('[name="message"]');
        const hiddenValues = {
          "lead-source": "ad-account-grader",
          "grader-grade": graderResult.grade,
          "grader-score": graderResult.score,
          "grader-industry": graderResult.industry || "",
          "grader-frustration": graderResult.frustration || "",
        };

        Object.entries(hiddenValues).forEach(function ([name, value]) {
          const input = form.querySelector(`[name="${name}"]`);
          if (input) input.value = value;
        });

        if (formTitle) formTitle.textContent = "Let’s review your ad account.";
        if (contextTitle) contextTitle.textContent = `Grade ${graderResult.grade}, ${graderResult.score}/100`;
        if (contextCopy) {
          contextCopy.textContent = `Industry context: ${graderResult.industry || "not specified"}. We will start with the diagnostic instead of asking you to explain it again.`;
        }
        if (contextBox) contextBox.hidden = false;
        if (message && !message.value) {
          message.value = `I completed the Ad Account Grader and scored ${graderResult.score}/100 (Grade ${graderResult.grade}). The issue I want to solve first: ${String(graderResult.frustration || "improving ad performance").toLowerCase()}. I would like help identifying the highest-impact fix.`;
        }

        const businessType = form.querySelector('[name="business-type"]');
        if (businessType && graderResult.industry) {
          businessType.value = String(graderResult.industry).includes("e-commerce") ? "ecommerce" : "local";
        }
      }
    }

    if (form) {
      const watch = watchLeadForm(form, "contact");
      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const submitBtn = form.querySelector('button[type="submit"]');
        const data = new FormData(form);
        const marketingConsent = data.get("sms-marketing") === "yes";
        const transactionalConsent = data.get("sms-transactional") === "yes";

        const interested =
          typeof window.__maaxgenInterestedServices === "function"
            ? window.__maaxgenInterestedServices()
            : [];

        const promo =
          typeof window.__maaxgenPromoAttribution === "function"
            ? window.__maaxgenPromoAttribution()
            : { promoId: "", promoName: "" };

        const { firstName, lastName } = splitName(String(data.get("name") || ""));
        const leadSource = String(data.get("lead-source") || "contact-page");
        const smsConsent = [marketingConsent ? "marketing" : "", transactionalConsent ? "transactional" : ""]
          .filter(Boolean)
          .join(",");

        const fields = {
          message: String(data.get("message") || ""),
          businessType: String(data.get("business-type") || ""),
          interestedServices: interested.map(function (s) { return s.name; }).join(","),
          interestedServiceIds: interested.map(function (s) { return s.id; }).join(","),
          promoId: promo.promoId,
          promoName: promo.promoName,
          smsConsent: smsConsent,
          smsMarketingConsent: marketingConsent ? "yes" : "no",
          smsTransactionalConsent: transactionalConsent ? "yes" : "no",
          smsMarketingConsentText: marketingConsent ? SMS_MARKETING_CONSENT : "",
          smsTransactionalConsentText: transactionalConsent ? SMS_TRANSACTIONAL_CONSENT : "",
          smsConsentVersion: SMS_CONSENT_VERSION,
          // During the offer, a marketing text opt-in waives the setup fee.
          setupFeeWaiver: promo.promoId && marketingConsent ? "yes" : "no",
          graderGrade: String(data.get("grader-grade") || ""),
          graderScore: String(data.get("grader-score") || ""),
          graderIndustry: String(data.get("grader-industry") || ""),
          graderFrustration: String(data.get("grader-frustration") || ""),
        };

        statusEl.hidden = true;
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending...";

        try {
          const res = await submitLead({
            formId: "contact",
            leadSource: leadSource,
            contact: {
              firstName: firstName,
              lastName: lastName,
              email: String(data.get("email") || ""),
              phone: String(data.get("phone") || ""),
            },
            fields: fields,
            hp: watch.hp(),
            startedAt: watch.startedAt(),
          });
          if (!res.ok) throw new Error(res.error || "Lead not accepted");

          form.hidden = true;
          successBox.hidden = false;
          successBox.focus();
        } catch (error) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Send the context →";
          statusEl.hidden = false;
          statusEl.textContent =
            "Sorry, something went wrong sending your message. Please try again.";
        }
      });
    }
  </script>

  <script>
    // Promotion attribution (empty strings unless the promotion is live on the visitor's clock).
    import { getPromoAttribution, initPromo } from "../components/promo/promo-client";
    initPromo();
    (window as unknown as { __maaxgenPromoAttribution: typeof getPromoAttribution }).__maaxgenPromoAttribution =
      getPromoAttribution;
  </script>

  <script>
    // Shortlist integration: ?service=<id>, ?source=service-studio, interested-services payload.
    import { addService, getShortlist, onShortlistChange } from "../lib/shortlist";
    import { serviceById } from "../data/services";

    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    if (form) {
      const params = new URLSearchParams(window.location.search);
      const serviceParam = params.get("service");
      if (serviceParam) addService(serviceParam);

      const current = () =>
        getShortlist().map((id) => ({ id, name: serviceById(id)?.name ?? id }));
      (window as unknown as { __maaxgenInterestedServices: typeof current }).__maaxgenInterestedServices = current;

      if (params.get("source") === "service-studio") {
        // The inline script runs first and sets "ad-account-grader" when the grader owns this lead.
        const leadSource = form.querySelector<HTMLInputElement>('[name="lead-source"]');
        if (leadSource && leadSource.value === "contact-page") leadSource.value = "service-studio";
      }

      const message = form.querySelector<HTMLTextAreaElement>('[name="message"]');
      let prefilled = "";
      const sentence = () => {
        const names = current().map((s) => s.name).join(", ");
        return names ? `I am interested in: ${names}.` : "";
      };
      const applyPrefill = () => {
        if (!message) return;
        // Only touch the box when it is empty or still holds our own untouched sentence.
        if (message.value && message.value !== prefilled) return;
        prefilled = sentence();
        message.value = prefilled;
      };
      if (params.get("source") === "service-studio" || serviceParam) {
        applyPrefill();
        onShortlistChange(applyPrefill);
      }
    }
  </script>
</BaseLayout>

<style>
  .founder-contact figcaption {
    color: oklch(0.8 0.02 245);
  }
  .founder-contact :global(.founder-photo) {
    border-color: oklch(0.75 0.025 245 / 0.3);
    box-shadow: 0 0.75rem 2rem -0.75rem oklch(0.05 0.03 245 / 0.5);
  }
  .contact-interest {
    margin-bottom: 1.25rem;
    padding: 0.9rem 1rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-surface);
  }
  .contact-interest[hidden] {
    display: none;
  }
  .contact-interest__title {
    margin: 0 0 0.6rem;
    color: var(--color-slate);
    font-size: 0.85rem;
    font-weight: 700;
  }
</style>
