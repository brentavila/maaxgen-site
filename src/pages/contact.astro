---
import BaseLayout from "../layouts/BaseLayout.astro";

const WEBHOOK_URL = "https://services.leadconnectorhq.com/hooks/yumx8KoOhRfNc1pxaesc/webhook-trigger/99267a30-84fa-46d6-9772-66e2c9c6ac42";

const SMS_MARKETING_CONSENT =
  "I consent to receive marketing text messages, about special offers, discounts, and service updates, from MaaxGen at the phone number provided. Message frequency may vary. Message & data rates may apply. Text HELP for assistance, reply STOP to opt out.";
const SMS_TRANSACTIONAL_CONSENT =
  "I consent to receive non-marketing text messages from MaaxGen about appointment and booking confirmations, replies to my inquiry, and account or service updates. Message frequency may vary. Message & data rates may apply. Text HELP for assistance, reply STOP to opt out.";
---

<BaseLayout title="Contact" description="Tell MaaxGen where growth feels disconnected and start a focused strategy conversation.">
  <section class="contact-stage">
    <div class="container contact-stage__grid">
      <div class="contact-stage__intro">
        <p class="hero-kicker">Start with the real problem</p>
        <h1>Tell us where growth feels <span>disconnected.</span></h1>
        <p class="lead">
          You do not need a polished brief. Share the goal, the friction, and what you want off your
          plate.
        </p>
        <ol class="contact-next">
          <li><span>01</span><div><strong>We review the context</strong><small>Business, goals, current channels, and urgency.</small></div></li>
          <li><span>02</span><div><strong>We find the first leverage point</strong><small>No generic audit or prewritten pitch.</small></div></li>
          <li><span>03</span><div><strong>You get a clear next step</strong><small>A fit recommendation, useful direction, or an honest no.</small></div></li>
        </ol>
        <p class="contact-stage__note">Typical response: within one business day.</p>
        <p class="contact-stage__grader-link">
          Not sure where the friction is? <a href="/ad-account-grader">Grade your ads first</a>.
        </p>
      </div>

      <div class="contact-stage__form-wrap">
        <div class="contact-form-heading">
          <span>Strategy conversation</span>
          <h2 data-contact-form-title>What are you trying to grow?</h2>
          <p>Required fields are kept short. Helpful context makes the first reply more useful.</p>
          <div class="contact-grader-context" data-grader-context hidden>
            <strong data-grader-context-title>Your ad grader result is attached.</strong>
            <p data-grader-context-copy>We will use it as the starting point for this conversation.</p>
          </div>
        </div>

        <form id="contact-form" class="form phase-contact-form" action={WEBHOOK_URL} method="post">
          <input type="hidden" name="lead-source" value="contact-page" />
          <input type="hidden" name="grader-grade" value="" />
          <input type="hidden" name="grader-score" value="" />
          <input type="hidden" name="grader-industry" value="" />
          <input type="hidden" name="grader-frustration" value="" />
          <div class="field-grid">
            <div>
              <label for="name">Name</label>
              <input id="name" name="name" type="text" required autocomplete="name" />
            </div>
            <div>
              <label for="email">Email</label>
              <input id="email" name="email" type="email" required autocomplete="email" />
            </div>
          </div>
          <div class="field-grid">
            <div>
              <label for="phone">Phone <span class="field-optional">(optional)</span></label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
            </div>
            <div>
              <label for="business-type">Business type</label>
              <select id="business-type" name="business-type">
                <option value="">Select one</option>
                <option value="local">Local business</option>
                <option value="ecommerce">E-commerce</option>
                <option value="both">Local and e-commerce</option>
              </select>
            </div>
          </div>

          <label for="message">Where is the friction?</label>
          <textarea
            id="message"
            name="message"
            required
            placeholder="Goals, current channels, timeline, and what you want off your plate"
          ></textarea>

          <fieldset class="consent phase-consent">
            <legend>Text message preferences <span class="field-optional">(optional)</span></legend>
            <p class="consent__intro">
              Your phone number and both choices below are optional. You can contact us without
              agreeing to text messages.
            </p>
            <label class="consent__item">
              <input type="checkbox" name="sms-marketing" value="yes" />
              <span>
                I consent to receive marketing text messages, about special offers, discounts, and
                service updates, from MaaxGen at the phone number provided. Message frequency may
                vary. Message &amp; data rates may apply. Text HELP for assistance, reply STOP to
                opt out.
              </span>
            </label>
            <label class="consent__item">
              <input type="checkbox" name="sms-transactional" value="yes" />
              <span>
                I consent to receive non-marketing text messages from MaaxGen about appointment and
                booking confirmations, replies to my inquiry, and account or service updates.
                Message frequency may vary. Message &amp; data rates may apply. Text HELP for
                assistance, reply STOP to opt out.
              </span>
            </label>
          </fieldset>

          <button type="submit" class="btn btn--primary phase-contact-form__submit">
            Send the context <span aria-hidden="true">→</span>
          </button>
          <p class="form-status" id="form-status" role="alert" hidden></p>
          <p class="form-legal">
            By submitting this form you agree to our <a href="/privacy">Privacy Policy</a> and
            <a href="/terms">Terms &amp; Conditions</a>. Mobile information and SMS consent are
            never shared or sold to third parties for marketing.
          </p>
        </form>

        <div id="form-success" class="phase-form-success" role="status" tabindex="-1" hidden>
          <span aria-hidden="true">✓</span>
          <h2>We have your message.</h2>
          <p>We will review the context and follow up with a useful next step or booking link.</p>
          <a class="btn btn--secondary" href="/services">Explore the growth system</a>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-fit-strip">
    <div class="container contact-fit-strip__grid">
      <p>What makes a useful first conversation</p>
      <div><span>01</span><strong>A real business goal</strong><small>Not a vanity metric target</small></div>
      <div><span>02</span><strong>Honest friction</strong><small>What is slow, unclear, or disconnected</small></div>
      <div><span>03</span><strong>Room to improve</strong><small>No expectation of overnight magic</small></div>
    </div>
  </section>

  <script define:vars={{ WEBHOOK_URL, SMS_MARKETING_CONSENT, SMS_TRANSACTIONAL_CONSENT }}>
    const form = document.getElementById("contact-form");
    const successBox = document.getElementById("form-success");
    const statusEl = document.getElementById("form-status");

    if (form) {
      const params = new URLSearchParams(window.location.search);
      let graderResult = null;

      if (params.get("source") === "ad-account-grader") {
        graderResult = {
          source: "ad-account-grader",
          grade: params.get("grade") || "",
          score: params.get("score") || "",
          industry: params.get("industry") || "",
          frustration: params.get("frustration") || "",
        };
      } else {
        try {
          const stored = window.sessionStorage.getItem("maaxgen-ad-grader-result");
          if (stored) graderResult = JSON.parse(stored);
        } catch {}
      }

      if (graderResult && graderResult.grade && graderResult.score) {
        const contextBox = document.querySelector("[data-grader-context]");
        const contextTitle = document.querySelector("[data-grader-context-title]");
        const contextCopy = document.querySelector("[data-grader-context-copy]");
        const formTitle = document.querySelector("[data-contact-form-title]");
        const message = form.querySelector('[name="message"]');
        const hiddenValues = {
          "lead-source": "ad-account-grader",
          "grader-grade": graderResult.grade,
          "grader-score": graderResult.score,
          "grader-industry": graderResult.industry || "",
          "grader-frustration": graderResult.frustration || "",
        };

        Object.entries(hiddenValues).forEach(function ([name, value]) {
          const input = form.querySelector(`[name="${name}"]`);
          if (input) input.value = value;
        });

        if (formTitle) formTitle.textContent = "Let’s review your ad account.";
        if (contextTitle) contextTitle.textContent = `Grade ${graderResult.grade}, ${graderResult.score}/100`;
        if (contextCopy) {
          contextCopy.textContent = `Industry context: ${graderResult.industry || "not specified"}. We will start with the diagnostic instead of asking you to explain it again.`;
        }
        if (contextBox) contextBox.hidden = false;
        if (message && !message.value) {
          message.value = `I completed the Ad Account Grader and scored ${graderResult.score}/100 (Grade ${graderResult.grade}). The issue I want to solve first: ${String(graderResult.frustration || "improving ad performance").toLowerCase()}. I would like help identifying the highest-impact fix.`;
        }

        const businessType = form.querySelector('[name="business-type"]');
        if (businessType && graderResult.industry) {
          businessType.value = String(graderResult.industry).includes("e-commerce") ? "ecommerce" : "local";
        }
      }
    }

    if (form) {
      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const submitBtn = form.querySelector('button[type="submit"]');
        const data = new FormData(form);
        const marketingConsent = data.get("sms-marketing") === "yes";
        const transactionalConsent = data.get("sms-transactional") === "yes";

        const payload = {
          name: data.get("name"),
          email: data.get("email"),
          phone: data.get("phone") || "",
          businessType: data.get("business-type") || "",
          message: data.get("message"),
          leadSource: data.get("lead-source") || "contact-page",
          adGrader: {
            grade: data.get("grader-grade") || "",
            score: data.get("grader-score") || "",
            industry: data.get("grader-industry") || "",
            frustration: data.get("grader-frustration") || "",
          },
          smsMarketingConsent: marketingConsent,
          smsTransactionalConsent: transactionalConsent,
          consentLanguage: {
            marketing: marketingConsent ? SMS_MARKETING_CONSENT : "",
            transactional: transactionalConsent ? SMS_TRANSACTIONAL_CONSENT : "",
          },
          submittedAt: new Date().toISOString(),
          pageUrl: window.location.href,
        };

        statusEl.hidden = true;
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending...";

        try {
          await fetch(WEBHOOK_URL, {
            method: "POST",
            mode: "no-cors",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });

          if (typeof window.fbq === "function") {
            window.fbq("track", "Lead", {
              content_name: "Contact Form",
              content_category: payload.businessType || "unspecified",
              value: 1,
              currency: "USD",
            });
          }

          form.hidden = true;
          successBox.hidden = false;
          successBox.focus();
        } catch (error) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Send the context →";
          statusEl.hidden = false;
          statusEl.textContent =
            "Sorry, something went wrong sending your message. Please try again.";
        }
      });
    }
  </script>
</BaseLayout>
