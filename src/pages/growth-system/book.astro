---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AttributionCapture from "../../components/funnel/AttributionCapture.astro";
import CalendarEmbed from "../../components/funnel/CalendarEmbed.astro";
import { FUNNEL_ROUTES } from "../../funnel/config";
---

<BaseLayout
  title="Book a Strategy Conversation"
  description="Choose a time to review your customer acquisition system with MaaxGen."
  chrome="landing"
  ctaHref={FUNNEL_ROUTES.results}
  ctaLabel="Back to results"
>
  <AttributionCapture />

  <section class="section funnel-book-page">
    <div class="container funnel-narrow">
      <div data-book-root>
        <p class="eyebrow">Strategy conversation</p>
        <h1 data-book-title>Choose a time that works.</h1>
        <p class="lead" data-book-body>
          We’ll review your current acquisition process, advertising, follow-up, and whether a
          connected system makes financial sense.
        </p>
        <div data-book-calendar>
          <CalendarEmbed />
        </div>
      </div>
    </div>
  </section>

  <script>
    import { playbookById } from "../../lib/brand-agent/playbooks";
    import { readFunnelState } from "../../funnel/state";

    const params = new URLSearchParams(window.location.search);
    const playbookFromAgent = playbookById(params.get("playbook") || "");
    if (playbookFromAgent) {
      const playbook = playbookFromAgent;
      const business = (params.get("business") || "").trim().replace(/[.,;:!?\s]+$/g, "");
      const title = document.querySelector<HTMLElement>("[data-book-title]");
      const body = document.querySelector<HTMLElement>("[data-book-body]");
      if (title) {
        title.textContent = `Let’s install the agents for your ${playbook.label}.`;
      }
      if (body) {
        const who = business || `your ${playbook.label}`;
        body.textContent = `We’ll walk through the three agents and the tracking workflow for ${who}, then confirm the 14-day sprint scope.`;
      }
    }

    const state = readFunnelState();
    const calendar = document.querySelector<HTMLElement>("[data-funnel-calendar]");
    if (calendar && state.qualificationStatus && state.qualificationStatus !== "NOT_QUALIFIED") {
      calendar.dataset.segment = state.qualificationStatus;
    }
    document.dispatchEvent(
      new CustomEvent("funnel:calendar-ready", {
        detail: { segment: calendar?.dataset.segment || "HIGHLY_QUALIFIED" },
      })
    );
  </script>
</BaseLayout>
