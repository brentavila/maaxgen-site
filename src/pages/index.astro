---
import BaseLayout from "../layouts/BaseLayout.astro";
import SprintOffer from "../components/SprintOffer.astro";
import { getCollection } from "astro:content";

const proofStories = (await getCollection("caseStudies"))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
  .slice(0, 2);

const growthLeaks = [
  {
    id: "ai-setup",
    shortLabel: "AI Setup Confusion",
    title: "I know I should use AI, but don't know how to set it up.",
    problem:
      "You've heard about ChatGPT Dots, Meta Muse, and AI automation, but you're afraid of breaking something, leaking data, or wasting time on tools that don't fit your business.",
    fix:
      "We architect, wire, and govern your internal AI agents so you can generate content, answer emails, and plan campaigns in 15 minutes a day instead of hours.",
    steps: ["Safe AI setup", "Your team trained", "Daily automation"],
  },
  {
    id: "ai-invisibility",
    shortLabel: "AI Invisibility",
    title: "ChatGPT and Google aren't recommending my business.",
    problem:
      "AI platforms like ChatGPT, Perplexity, and Meta Muse are becoming the new search engines. If they don't understand what you sell or trust your reputation, they'll send customers to your competitor.",
    fix:
      "We make your business machine-legible by updating schema markup, entity data, review architecture, and pricing structure so AI agents trust and recommend you.",
    steps: ["AI can read you", "Trust signals verified", "You get recommended"],
  },
  {
    id: "ad-tracking",
    shortLabel: "Broken Ad Tracking",
    title: "I'm spending money on ads, but can't tell what's working.",
    problem:
      "Meta and Google's AI needs accurate conversion data to optimize. When your tracking is broken, the algorithm guesses wrong and wastes your budget on low-quality clicks.",
    fix:
      "We install airtight conversion tracking, server-side CAPI, CRM pipeline integration, and offline conversion imports so every ad dollar is tracked to real revenue.",
    steps: ["Tracking installed", "Data feeds AI", "Budget optimizes itself"],
  },
];

const fitSignals = [
  {
    title: "You want the why, not just the report.",
    body: "Every recommendation comes with the reasoning, the expected outcome, and the next decision.",
  },
  {
    title: "You care about revenue, not applause.",
    body: "Qualified leads, acquisition cost, conversion rate, and return matter more than vanity metrics.",
  },
  {
    title: "You would rather learn the tools than outsource everything.",
    body: "You want AI agents set up safely in your own business, with the guardrails and training to run them in 15 minutes a day.",
  },
  {
    title: "You choose fit and accountability over the lowest bid.",
    body: "You value clear ownership, honest answers, and work that does not need to be rebuilt twice.",
  },
];
---

<BaseLayout
  title="MaaxGen"
  description="MaaxGen helps small businesses put AI agents to work, get recommended by ChatGPT and Google, fix ad tracking, and follow up with every lead instantly."
>
  <section class="engagement-hero">
    <div class="engagement-hero__glow" aria-hidden="true"></div>
    <div class="container engagement-hero__grid">
      <div class="engagement-hero__copy">
        <p class="hero-kicker">AI-Era Growth & Implementation Partner</p>
        <h1 class="engagement-hero__title--long">
          Customers are using AI to shop. Competitors are using AI to market.
          <span>Don't get left behind.</span>
        </h1>
        <p class="lead">
          We help small businesses set up daily AI agents (like ChatGPT Dots & Meta Muse), lock in airtight ad tracking, and make sure AI platforms actually recommend your brand.
        </p>
        <div class="cta-row">
          <a class="btn btn--primary" href="/ai-readiness-scanner">
            Check my AI readiness
            <span aria-hidden="true">→</span>
          </a>
          <a class="btn btn--secondary" href="/case-studies">See the work</a>
        </div>
        <p class="hero-availability">
          <span aria-hidden="true"></span>
          Will AI recommend your business—or your competitor? Enter your URL for a free 60-second scan.
        </p>
      </div>

      <div
        class="engine-map"
        role="img"
        aria-label="AI agents, AI visibility, ad tracking, and instant follow-up connected around one growth plan"
      >
        <svg class="engine-map__lines" viewBox="0 0 600 520" aria-hidden="true">
          <path d="M300 260 L136 116" />
          <path d="M300 260 L464 116" />
          <path d="M300 260 L136 404" />
          <path d="M300 260 L464 404" />
        </svg>
        <div class="engine-map__core">
          <span>Your business</span>
          <strong>AI-ready</strong>
          <small>in weeks, not quarters</small>
        </div>
        <div class="engine-node engine-node--strategy">
          <span>01</span>
          <strong>Put AI Agents to Work</strong>
          <small>automate your busywork</small>
        </div>
        <div class="engine-node engine-node--creative">
          <span>02</span>
          <strong>Make Your Brand Visible to AI</strong>
          <small>get recommended</small>
        </div>
        <div class="engine-node engine-node--media">
          <span>03</span>
          <strong>Fix Your Ad Tracking</strong>
          <small>stop wasting ad spend</small>
        </div>
        <div class="engine-node engine-node--followup">
          <span>04</span>
          <strong>Instant Lead Follow-Up</strong>
          <small>never miss a buyer</small>
        </div>
      </div>
    </div>
  </section>

  <div class="growth-chain" aria-label="The MaaxGen growth process">
    <div class="container growth-chain__inner">
      <span>AI agents working</span>
      <i aria-hidden="true">→</i>
      <span>Brand visible to AI</span>
      <i aria-hidden="true">→</i>
      <span>Tracking locked in</span>
      <i aria-hidden="true">→</i>
      <span>Instant follow-up</span>
    </div>
  </div>

  <section class="section grader-promo-section">
    <div class="container grader-promo">
      <div class="grader-promo__copy" data-reveal>
        <p class="eyebrow">Free AI & Agent Readiness Scanner</p>
        <h2>Will AI recommend your business—or skip you for the competitor down the street?</h2>
        <p class="lead">
          ChatGPT, Meta Muse, and Instinct are shopping for your customers right now. Enter your
          website and see what AI actually thinks you sell, whether agents can book or buy from
          you, and whether your ads are tracked.
        </p>
        <div class="cta-row">
          <a class="btn btn--primary" href="/ai-readiness-scanner">
            Scan my website <span aria-hidden="true">→</span>
          </a>
          <span class="grader-promo__time">Live checks, about a minute. Results on screen.</span>
        </div>
      </div>

      <div class="grader-promo__readout" data-reveal aria-label="What the AI readiness scanner checks">
        <div class="grader-promo__readout-head">
          <span>AI & Agent Readiness Scan</span>
          <strong>Just your URL</strong>
        </div>
        <ol>
          <li><span>01</span><div><strong>Recommendability</strong><small>Do AI platforms understand what you sell?</small></div></li>
          <li><span>02</span><div><strong>Agent Friction</strong><small>Can AI agents book, buy, or quote without getting stuck?</small></div></li>
          <li><span>03</span><div><strong>Signal & Tracking</strong><small>Are your ads feeding accurate data to the machines?</small></div></li>
        </ol>
        <p>Get a score out of 100, a live quote of what ChatGPT thinks you sell, the competitors it recommended instead, and the three moves that put you ahead.</p>
      </div>
    </div>
  </section>

  <section class="section leak-explorer-section">
    <div class="container">
      <div class="section-heading section-heading--wide" data-reveal>
        <p class="eyebrow">Which problem feels most familiar?</p>
        <h2>Pick the one keeping you up at night.</h2>
        <p class="lead">
          Choose the challenge that matches your situation. We'll show you what the AI-era solution looks like.
        </p>
      </div>

      <div class="leak-explorer" data-leak-explorer data-reveal>
        <div class="leak-explorer__tabs" role="tablist" aria-label="Common growth problems">
          {growthLeaks.map((leak, index) => (
            <button
              type="button"
              role="tab"
              id={`tab-${leak.id}`}
              aria-controls={`panel-${leak.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? 0 : -1}
              data-leak-tab
            >
              <span>0{index + 1}</span>
              {leak.shortLabel}
            </button>
          ))}
        </div>

        <div class="leak-explorer__panels">
          {growthLeaks.map((leak, index) => (
            <article
              class="leak-panel"
              id={`panel-${leak.id}`}
              role="tabpanel"
              aria-labelledby={`tab-${leak.id}`}
              hidden={index !== 0}
              data-leak-panel
            >
              <div class="leak-panel__copy">
                <p class="leak-panel__signal">What is happening</p>
                <h3>{leak.title}</h3>
                <p>{leak.problem}</p>
                <div class="leak-panel__fix">
                  <strong>The connected fix</strong>
                  <p>{leak.fix}</p>
                </div>
              </div>
              <ol class="leak-flow" aria-label={`Connected solution for ${leak.shortLabel}`}>
                {leak.steps.map((step, stepIndex) => (
                  <li>
                    <span>0{stepIndex + 1}</span>
                    <strong>{step}</strong>
                  </li>
                ))}
              </ol>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section system-comparison-section">
    <div class="container comparison-heading" data-reveal>
      <div>
        <p class="eyebrow">Drag to compare</p>
        <h2>What changes when your business is ready for AI.</h2>
      </div>
      <p>
        Same business, same budget. Move the slider to see the difference between a business AI
        skips and a business AI recommends.
      </p>
    </div>

    <div class="system-comparison" data-system-comparison data-reveal style="--split: 50%">
      <div class="system-comparison__scene system-comparison__scene--connected">
        <p class="comparison-label">AI-ready</p>
        <div class="comparison-system comparison-system--connected">
          <div><span>ChatGPT</span><small>recommends you by name</small></div>
          <div><span>AI agents</span><small>book and buy without friction</small></div>
          <div><span>Ad tracking</span><small>every dollar tied to revenue</small></div>
          <div><span>Follow-up</span><small>answered in under a minute</small></div>
        </div>
        <p class="comparison-result">More customers. Less wasted spend. Ten hours a week back.</p>
      </div>

      <div class="system-comparison__scene system-comparison__scene--scattered">
        <p class="comparison-label">Invisible to AI</p>
        <div class="comparison-system comparison-system--scattered">
          <div><span>ChatGPT</span><small>suggests your competitor</small></div>
          <div><span>AI agents</span><small>hit "call for quote" and leave</small></div>
          <div><span>Ad tracking</span><small>broken pixel, guessing algorithm</small></div>
          <div><span>Follow-up</span><small>leads wait, then go cold</small></div>
        </div>
        <p class="comparison-result">Customers you never knew you lost.</p>
      </div>

      <div class="system-comparison__divider" aria-hidden="true">
        <span>↔</span>
      </div>
      <label class="sr-only" for="system-comparison-range">
        Compare a business invisible to AI with an AI-ready business
      </label>
      <input
        id="system-comparison-range"
        class="system-comparison__range"
        type="range"
        min="12"
        max="88"
        value="50"
        data-comparison-range
      />
    </div>
  </section>

  <section class="section fit-section">
    <div class="container fit-layout">
      <div class="fit-statement" data-reveal>
        <p class="eyebrow">A better working relationship</p>
        <h2>You will probably enjoy working with us if...</h2>
        <p>
          You want to run your own daily marketing with AI, and a partner who handles the
          technical foundations you should not have to learn.
        </p>
        <a href="/about">Meet MaaxGen <span aria-hidden="true">→</span></a>
      </div>
      <ol class="fit-signals">
        {fitSignals.map((signal, index) => (
          <li data-reveal style={`--reveal-delay: ${index * 0.07}s`}>
            <span>0{index + 1}</span>
            <div>
              <h3>{signal.title}</h3>
              <p>{signal.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section proof-section">
    <div class="container">
      <div class="proof-section__heading" data-reveal>
        <div>
          <p class="eyebrow">Example engagements</p>
          <h2>See what this looks like for a real business.</h2>
        </div>
        <a class="btn btn--secondary" href="/case-studies">Explore the examples</a>
      </div>
      <div class="proof-stories">
        {proofStories.map((study, index) => (
          <a
            class="proof-story"
            href={`/case-studies/${study.id}`}
            data-reveal
            style={`--reveal-delay: ${index * 0.1}s`}
          >
            <span class="proof-story__type">
              Example: {study.data.industry === "local" ? "Local business" : "E-commerce"}
            </span>
            <h3>{study.data.title}</h3>
            <p>{study.data.outcome}</p>
            <span class="proof-story__link">Read the story <i aria-hidden="true">→</i></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <SprintOffer source="home" />

  <section class="home-final-cta">
    <div class="container home-final-cta__inner" data-reveal>
      <p>Your competitors are not waiting.</p>
      <h2>Let’s get your business ready for the AI era before they do.</h2>
      <a class="btn btn--primary" href="/contact">Book a strategy call <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>("[data-leak-explorer]").forEach((explorer) => {
    const tabs = Array.from(explorer.querySelectorAll<HTMLButtonElement>("[data-leak-tab]"));
    const panels = Array.from(explorer.querySelectorAll<HTMLElement>("[data-leak-panel]"));

    const activate = (tab: HTMLButtonElement) => {
      const panelId = tab.getAttribute("aria-controls");

      tabs.forEach((item) => {
        const selected = item === tab;
        item.setAttribute("aria-selected", String(selected));
        item.tabIndex = selected ? 0 : -1;
      });

      panels.forEach((panel) => {
        panel.hidden = panel.id !== panelId;
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(tab));
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        const direction = event.key === "ArrowRight" ? 1 : -1;
        const next = tabs[(index + direction + tabs.length) % tabs.length];
        activate(next);
        next.focus();
      });
    });
  });

  document.querySelectorAll<HTMLElement>("[data-system-comparison]").forEach((comparison) => {
    const range = comparison.querySelector<HTMLInputElement>("[data-comparison-range]");
    if (!range) return;

    const update = () => comparison.style.setProperty("--split", `${range.value}%`);
    range.addEventListener("input", update);
    update();
  });
</script>
