---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const proofStories = (await getCollection("caseStudies"))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
  .slice(0, 2);

const growthLeaks = [
  {
    id: "follow-up",
    shortLabel: "Slow follow-up",
    title: "Good leads go cold while your team is busy.",
    problem:
      "A customer calls, fills out a form, or starts a checkout. Then they wait. The next business to respond gets the opportunity.",
    fix:
      "Instant replies, missed-call text back, and clear pipeline reminders keep every inquiry moving.",
    steps: ["New inquiry", "Instant response", "Booked next step"],
  },
  {
    id: "website",
    shortLabel: "Weak conversion",
    title: "Your website gets attention, but not enough action.",
    problem:
      "The ad earns the click, then vague copy and a buried next step make the visitor work too hard.",
    fix:
      "We align the message, offer, and landing page so the path from interest to action feels obvious.",
    steps: ["Relevant ad", "Matched landing page", "Clear action"],
  },
  {
    id: "systems",
    shortLabel: "Disconnected tools",
    title: "Your tools create more work than they remove.",
    problem:
      "Campaigns, customer data, and AI tools live in separate places. Your team spends time moving information instead of using it.",
    fix:
      "We connect the useful pieces, remove the noise, and document workflows your team can trust.",
    steps: ["Clean inputs", "Connected workflow", "Useful output"],
  },
];

const fitSignals = [
  {
    title: "You want the why, not just the report.",
    body: "Every recommendation comes with the reasoning, the expected outcome, and the next decision.",
  },
  {
    title: "You care about revenue, not applause.",
    body: "Qualified leads, acquisition cost, conversion rate, and return matter more than vanity metrics.",
  },
  {
    title: "You are building for the long term.",
    body: "You want a partner who learns the business and makes every campaign smarter than the last.",
  },
  {
    title: "You choose fit and accountability over the lowest bid.",
    body: "You value clear ownership, honest answers, and work that does not need to be rebuilt twice.",
  },
];
---

<BaseLayout
  title="MaaxGen"
  description="One agency partner connecting strategy, creative, advertising, and follow-up into a growth system for local and e-commerce businesses."
>
  <section class="engagement-hero">
    <div class="engagement-hero__glow" aria-hidden="true"></div>
    <div class="container engagement-hero__grid">
      <div class="engagement-hero__copy">
        <p class="hero-kicker">One accountable growth partner</p>
        <h1>Your marketing should work like a system. <span>Not a pile of projects.</span></h1>
        <p class="lead">
          MaaxGen connects strategy, creative, advertising, and follow-up so every part helps the
          next part perform better.
        </p>
        <div class="cta-row">
          <a class="btn btn--primary" href="/ad-account-grader">
            Grade my ads
            <span aria-hidden="true">→</span>
          </a>
          <a class="btn btn--secondary" href="/case-studies">See the work</a>
        </div>
        <p class="hero-availability">
          <span aria-hidden="true"></span>
          Free two-minute diagnostic. No ad account login required.
        </p>
      </div>

      <div
        class="engine-map"
        role="img"
        aria-label="Strategy, creative, advertising, and follow-up connected around one growth plan"
      >
        <svg class="engine-map__lines" viewBox="0 0 600 520" aria-hidden="true">
          <path d="M300 260 L136 116" />
          <path d="M300 260 L464 116" />
          <path d="M300 260 L136 404" />
          <path d="M300 260 L464 404" />
        </svg>
        <div class="engine-map__core">
          <span>One plan</span>
          <strong>Growth</strong>
          <small>measured and improved</small>
        </div>
        <div class="engine-node engine-node--strategy">
          <span>01</span>
          <strong>Strategy</strong>
          <small>the right priority</small>
        </div>
        <div class="engine-node engine-node--creative">
          <span>02</span>
          <strong>Creative</strong>
          <small>a message that lands</small>
        </div>
        <div class="engine-node engine-node--media">
          <span>03</span>
          <strong>Advertising</strong>
          <small>attention with intent</small>
        </div>
        <div class="engine-node engine-node--followup">
          <span>04</span>
          <strong>Follow-up</strong>
          <small>interest into action</small>
        </div>
      </div>
    </div>
  </section>

  <div class="growth-chain" aria-label="The MaaxGen growth process">
    <div class="container growth-chain__inner">
      <span>Clear strategy</span>
      <i aria-hidden="true">→</i>
      <span>Stronger creative</span>
      <i aria-hidden="true">→</i>
      <span>Smarter media</span>
      <i aria-hidden="true">→</i>
      <span>Faster follow-up</span>
    </div>
  </div>

  <section class="section grader-promo-section">
    <div class="container grader-promo">
      <div class="grader-promo__copy" data-reveal>
        <p class="eyebrow">Free ad account grader</p>
        <h2>Find the weak point before you spend another dollar.</h2>
        <p class="lead">
          No dashboards, spreadsheets, or ROAS math. Answer five questions you already know and
          get a practical grade for the system around your ads.
        </p>
        <div class="cta-row">
          <a class="btn btn--primary" href="/ad-account-grader">
            Grade my ads <span aria-hidden="true">→</span>
          </a>
          <span class="grader-promo__time">Two minutes. Results shown immediately.</span>
        </div>
      </div>

      <div class="grader-promo__readout" data-reveal aria-label="What the ad account grader checks">
        <div class="grader-promo__readout-head">
          <span>Account diagnostic</span>
          <strong>No login required</strong>
        </div>
        <ol>
          <li><span>01</span><div><strong>Measurement</strong><small>Can spend be connected to a real outcome?</small></div></li>
          <li><span>02</span><div><strong>Ownership</strong><small>Does someone make informed changes each week?</small></div></li>
          <li><span>03</span><div><strong>Optimization readiness</strong><small>Is there enough signal to know what to fix next?</small></div></li>
        </ol>
        <p>Get a letter grade, an industry-specific benchmark, and three next moves.</p>
      </div>
    </div>
  </section>

  <section class="section leak-explorer-section">
    <div class="container">
      <div class="section-heading section-heading--wide" data-reveal>
        <p class="eyebrow">Find the leak</p>
        <h2>Where is growth slipping through?</h2>
        <p class="lead">
          Choose the problem that feels most familiar. We will show you what a connected fix looks
          like.
        </p>
      </div>

      <div class="leak-explorer" data-leak-explorer data-reveal>
        <div class="leak-explorer__tabs" role="tablist" aria-label="Common growth problems">
          {growthLeaks.map((leak, index) => (
            <button
              type="button"
              role="tab"
              id={`tab-${leak.id}`}
              aria-controls={`panel-${leak.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? 0 : -1}
              data-leak-tab
            >
              <span>0{index + 1}</span>
              {leak.shortLabel}
            </button>
          ))}
        </div>

        <div class="leak-explorer__panels">
          {growthLeaks.map((leak, index) => (
            <article
              class="leak-panel"
              id={`panel-${leak.id}`}
              role="tabpanel"
              aria-labelledby={`tab-${leak.id}`}
              hidden={index !== 0}
              data-leak-panel
            >
              <div class="leak-panel__copy">
                <p class="leak-panel__signal">What is happening</p>
                <h3>{leak.title}</h3>
                <p>{leak.problem}</p>
                <div class="leak-panel__fix">
                  <strong>The connected fix</strong>
                  <p>{leak.fix}</p>
                </div>
              </div>
              <ol class="leak-flow" aria-label={`Connected solution for ${leak.shortLabel}`}>
                {leak.steps.map((step, stepIndex) => (
                  <li>
                    <span>0{stepIndex + 1}</span>
                    <strong>{step}</strong>
                  </li>
                ))}
              </ol>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section system-comparison-section">
    <div class="container comparison-heading" data-reveal>
      <div>
        <p class="eyebrow">Drag to compare</p>
        <h2>From scattered effort to one connected engine.</h2>
      </div>
      <p>
        The work does not disappear. The friction does. Move the slider to see what changes when
        one partner owns the whole path.
      </p>
    </div>

    <div class="system-comparison" data-system-comparison data-reveal style="--split: 50%">
      <div class="system-comparison__scene system-comparison__scene--connected">
        <p class="comparison-label">Connected</p>
        <div class="comparison-system comparison-system--connected">
          <div><span>Strategy</span><small>one priority</small></div>
          <div><span>Creative</span><small>one message</small></div>
          <div><span>Media</span><small>one campaign plan</small></div>
          <div><span>Follow-up</span><small>one customer path</small></div>
        </div>
        <p class="comparison-result">Clear ownership. Faster learning. Better decisions.</p>
      </div>

      <div class="system-comparison__scene system-comparison__scene--scattered">
        <p class="comparison-label">Scattered</p>
        <div class="comparison-system comparison-system--scattered">
          <div><span>Freelancer</span><small>waiting on copy</small></div>
          <div><span>Ad vendor</span><small>optimizing clicks</small></div>
          <div><span>Website</span><small>different message</small></div>
          <div><span>CRM</span><small>leads sitting cold</small></div>
        </div>
        <p class="comparison-result">More handoffs. Slower answers. Nobody owns the outcome.</p>
      </div>

      <div class="system-comparison__divider" aria-hidden="true">
        <span>↔</span>
      </div>
      <label class="sr-only" for="system-comparison-range">
        Compare scattered and connected marketing systems
      </label>
      <input
        id="system-comparison-range"
        class="system-comparison__range"
        type="range"
        min="12"
        max="88"
        value="50"
        data-comparison-range
      />
    </div>
  </section>

  <section class="section fit-section">
    <div class="container fit-layout">
      <div class="fit-statement" data-reveal>
        <p class="eyebrow">A better working relationship</p>
        <h2>You will probably enjoy working with us if...</h2>
        <p>
          You want a marketing partner who can think, execute, explain, and own the result.
        </p>
        <a href="/about">Meet MaaxGen <span aria-hidden="true">→</span></a>
      </div>
      <ol class="fit-signals">
        {fitSignals.map((signal, index) => (
          <li data-reveal style={`--reveal-delay: ${index * 0.07}s`}>
            <span>0{index + 1}</span>
            <div>
              <h3>{signal.title}</h3>
              <p>{signal.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section proof-section">
    <div class="container">
      <div class="proof-section__heading" data-reveal>
        <div>
          <p class="eyebrow">Example engagements</p>
          <h2>See how the system comes together.</h2>
        </div>
        <a class="btn btn--secondary" href="/case-studies">Explore the examples</a>
      </div>
      <div class="proof-stories">
        {proofStories.map((study, index) => (
          <a
            class="proof-story"
            href={`/case-studies/${study.id}`}
            data-reveal
            style={`--reveal-delay: ${index * 0.1}s`}
          >
            <span class="proof-story__type">
              Example: {study.data.industry === "local" ? "Local business" : "E-commerce"}
            </span>
            <h3>{study.data.title}</h3>
            <p>{study.data.outcome}</p>
            <span class="proof-story__link">Read the story <i aria-hidden="true">→</i></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-final-cta">
    <div class="container home-final-cta__inner" data-reveal>
      <p>Ready for fewer moving parts?</p>
      <h2>Let’s turn your marketing into one accountable growth engine.</h2>
      <a class="btn btn--primary" href="/contact">Book a strategy call <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>("[data-leak-explorer]").forEach((explorer) => {
    const tabs = Array.from(explorer.querySelectorAll<HTMLButtonElement>("[data-leak-tab]"));
    const panels = Array.from(explorer.querySelectorAll<HTMLElement>("[data-leak-panel]"));

    const activate = (tab: HTMLButtonElement) => {
      const panelId = tab.getAttribute("aria-controls");

      tabs.forEach((item) => {
        const selected = item === tab;
        item.setAttribute("aria-selected", String(selected));
        item.tabIndex = selected ? 0 : -1;
      });

      panels.forEach((panel) => {
        panel.hidden = panel.id !== panelId;
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(tab));
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        const direction = event.key === "ArrowRight" ? 1 : -1;
        const next = tabs[(index + direction + tabs.length) % tabs.length];
        activate(next);
        next.focus();
      });
    });
  });

  document.querySelectorAll<HTMLElement>("[data-system-comparison]").forEach((comparison) => {
    const range = comparison.querySelector<HTMLInputElement>("[data-comparison-range]");
    if (!range) return;

    const update = () => comparison.style.setProperty("--split", `${range.value}%`);
    range.addEventListener("input", update);
    update();
  });
</script>
