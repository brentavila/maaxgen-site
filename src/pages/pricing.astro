---
import BaseLayout from "../layouts/BaseLayout.astro";

const tiers = [
  {
    step: "Start",
    name: "Growth foundation",
    scope: "Focused starting scope",
    fit: "For businesses putting consistent marketing basics in place.",
    result: "A clear message, a focused channel, and the tracking to know what happens next.",
    includes: [
      "Strategy kickoff and 90-day roadmap",
      "Offer and message refinement",
      "Brand-aligned creative kit",
      "Landing page or website tune-up",
      "One paid channel launch",
      "Speed-to-lead reply basics",
    ],
    cta: "Start with the foundation",
  },
  {
    step: "Grow",
    name: "Performance engine",
    scope: "Ongoing growth scope",
    fit: "For owners ready to improve paid acquisition every month.",
    result: "Ongoing media, fresh creative, conversion pages, and follow-up under one plan.",
    includes: [
      "Multi-channel ads and testing",
      "Campaign landing pages",
      "Monthly creative refreshes",
      "Full lead follow-up system",
      "AI-assisted briefs and variants",
      "Monthly optimization review",
    ],
    featured: true,
    cta: "Explore the performance scope",
  },
  {
    step: "Scale",
    name: "AI-accelerated scale",
    scope: "Integrated scale scope",
    fit: "For higher-volume teams that need deeper automation and strategy.",
    result: "A connected operating layer for content, campaigns, reporting, and conversion.",
    includes: [
      "Advanced workflow design",
      "Website and conversion management",
      "Custom AI systems with human review",
      "Higher-touch strategy",
      "Decision dashboards",
      "Cross-channel scale planning",
    ],
    cta: "Plan for scale",
  },
];

const everyTier = [
  "You own every account, asset, and data source",
  "Three-month initial term, then month to month",
  "Ad spend paid directly to platforms with no markup",
  "Reporting written for business owners",
  "30-day notice after the initial term",
  "Scope and terms documented before work begins",
];

const comparison = [
  ["Strategy", "90-day roadmap", "Monthly planning", "Quarterly scale planning"],
  ["Paid media", "One focused channel", "Multi-channel testing", "Channel and budget strategy"],
  ["Web and landing pages", "Core page tune-up", "Campaign pages tested", "Full conversion management"],
  ["Lead follow-up", "Speed-to-lead basics", "Pipeline and reminders", "Custom routing and handoffs"],
  ["Creative", "Launch kit", "Monthly refreshes", "Expanded testing system"],
  ["AI workflows", "Light setup", "Briefs and variants", "Custom operating workflows"],
];

const faqs = [
  {
    q: "Why are prices not listed here?",
    a: "The right scope depends on your channels, creative cadence, conversion path, follow-up needs, and reporting complexity. We first understand the business and recommend the smallest engagement that can solve the real problem. You receive clear scope and terms before making a decision.",
  },
  {
    q: "How fast will we see results?",
    a: "Follow-up and landing-page fixes can improve existing demand within weeks. Paid campaigns usually need 60 to 90 days of testing before returns become reliable. We will show you early signals without pretending they are final answers.",
  },
  {
    q: "Is ad spend included?",
    a: "No. Platforms bill you directly, so media costs remain transparent. MaaxGen scope is confirmed separately after we understand the channels, creative, conversion work, and systems the engagement needs.",
  },
  {
    q: "What is the commitment?",
    a: "A three-month initial term, then month to month with 30 days notice. That gives the work enough time to produce honest learning without locking you into a long contract.",
  },
  {
    q: "Who owns the accounts and data?",
    a: "You do, from day one. Your ad accounts, website, CRM, creative, and campaign history stay with your business.",
  },
  {
    q: "Will we need to replace our tools?",
    a: "Not by default. We start with what you have and only recommend a change when the current setup is clearly costing leads, time, or trustworthy data.",
  },
  {
    q: "How do you use AI?",
    a: "AI supports drafts, variants, routing, and data organization. A person approves what customers see and remains accountable for every recommendation.",
  },
];
---

<BaseLayout title="Engagements" description="Compare MaaxGen engagement levels for connected strategy, creative, advertising, follow-up, and AI services.">
  <section class="phase-hero phase-hero--pricing">
    <div class="container phase-hero__grid">
      <div>
        <p class="hero-kicker">Clear scope. Visible ownership.</p>
        <h1>Choose the depth, <span>not a prebuilt package.</span></h1>
        <p class="lead">
          Your channels, creative needs, follow-up, and operating complexity shape the work. We
          recommend a scope after we understand the system, then document it before you decide.
        </p>
      </div>
      <div class="pricing-path" aria-label="Three service levels from foundation to performance to scale">
        {tiers.map((tier, index) => (
          <div class:list={["pricing-path__step", tier.featured && "pricing-path__step--active"]}>
            <span>0{index + 1}</span>
            <strong>{tier.step}</strong>
            <small>{tier.name}</small>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section pricing-tiers-section">
    <div class="container">
      <div class="pricing-intro" data-reveal>
        <p class="eyebrow">Engagement levels</p>
        <h2>Three levels. One accountable team.</h2>
        <p>Every level connects strategy to execution. The difference is cadence, channel depth, and operational complexity—not a one-size-fits-all price.</p>
      </div>
      <div class="phase-tier-list">
        {tiers.map((tier, index) => (
          <article class:list={["phase-tier", tier.featured && "phase-tier--featured"]} data-reveal style={`--reveal-delay: ${index * 0.08}s`}>
            <div class="phase-tier__topline">
              <span>{tier.step}</span>
              {tier.featured && <strong>Most common fit</strong>}
            </div>
            <h2>{tier.name}</h2>
            <p class="phase-tier__scope">{tier.scope}</p>
            <p class="phase-tier__fit">{tier.fit}</p>
            <p class="phase-tier__result">{tier.result}</p>
            <ul>{tier.includes.map((item) => <li>{item}</li>)}</ul>
            <a class:list={["btn", tier.featured ? "btn--primary" : "btn--secondary"]} href={`/contact?tier=${tier.name.toLowerCase().replaceAll(" ", "-")}`}>
              {tier.cta}
            </a>
          </article>
        ))}
      </div>
      <div class="phase-included" data-reveal>
        <div>
          <span>Across every tier</span>
          <h3>The terms should be as clear as the work.</h3>
        </div>
        <ul>{everyTier.map((item) => <li>{item}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section phase-comparison-section">
    <div class="container">
      <div class="comparison-heading" data-reveal>
        <div>
          <p class="eyebrow">Scope comparison</p>
          <h2>See what expands as the system grows.</h2>
        </div>
        <p>Scroll across on smaller screens. Nothing important is hidden behind a sales call.</p>
      </div>
      <div class="comparison-table phase-comparison-table" role="region" aria-label="Engagement scope comparison" tabindex="0" data-reveal>
        <table>
          <thead>
            <tr>
              <th scope="col">Capability</th>
              <th scope="col">Foundation</th>
              <th scope="col">Performance</th>
              <th scope="col">Scale</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr>{row.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section pricing-faq-section">
    <div class="container pricing-faq-layout">
      <div data-reveal>
        <p class="eyebrow">Straight answers</p>
        <h2>The questions owners ask before signing.</h2>
        <p>No black-box language. No surprise ownership terms.</p>
      </div>
      <div class="faq phase-faq" data-reveal>
        {faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <div class="faq__body"><p>{faq.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="home-final-cta">
    <div class="container home-final-cta__inner" data-reveal>
      <p>Not sure where the weak point is?</p>
      <h2>Start with a free diagnostic before discussing scope.</h2>
      <a class="btn btn--primary" href="/ad-account-grader">Grade my ads <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
