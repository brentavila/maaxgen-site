---
import BaseLayout from "../layouts/BaseLayout.astro";

const pillars = [
  {
    index: "01",
    title: "Put AI agents to work",
    outcome: "Automate your busywork without breaking anything.",
    detail:
      "We set up ChatGPT Dots, Meta Muse, or custom workflows inside your business, write the permission rules and guardrails so an agent never emails the wrong client, and train you to run daily marketing in 15 minutes a day.",
    items: ["AI agent setup and permissions", "Safety guardrails and data governance", "Owner and team training"],
  },
  {
    index: "02",
    title: "Make your brand visible to AI",
    outcome: "Get recommended when customers ask ChatGPT, Google, or Meta.",
    detail:
      "AI agents do not care about your colors. They read schema markup, structured pricing, review sentiment, and response times. We build the machine-readable proof that makes them trust and recommend you.",
    items: ["Schema and structured pricing", "Review velocity and citations", "Agent-friendly booking and checkout"],
  },
  {
    index: "03",
    title: "Fix your ad tracking",
    outcome: "Stop wasting ad spend on an algorithm that is guessing.",
    detail:
      "Meta Advantage+ and Google PMax learn from the data you feed back. We build the pipes: server-side CAPI, CRM pipeline integration, and offline conversion imports that train the platforms to find your highest-paying customers.",
    items: ["Server-side conversion tracking", "CRM and offline conversion imports", "Paid media managed against revenue"],
  },
  {
    index: "04",
    title: "Instant lead follow-up",
    outcome: "Never miss a buyer, whether a human or an AI agent is calling.",
    detail:
      "Agents like Instinct now phone local businesses to book appointments and request quotes. We install instant SMS and AI-voice answering so every inquiry gets a response in under a minute.",
    items: ["AI voice and SMS answering", "Missed-call text back", "Pipeline reminders and booking"],
  },
];

const leadJourney = [
  { when: "Minute 1", title: "Inquiry answered", detail: "A human or an AI agent reaches out. An on-brand response arrives while interest is high." },
  { when: "Day 1", title: "Next step booked", detail: "Reminders keep the opportunity moving without chasing spreadsheets." },
  { when: "Week 1", title: "Revenue connected", detail: "The pipeline shows what closed and sends that signal back to Meta and Google." },
  { when: "Next campaign", title: "Learning compounds", detail: "The platforms' AI targets better because the data it learns from is true." },
];

const expectations = [
  {
    window: "Days 1–30",
    title: "Build the foundation",
    items: ["AI readiness baseline", "Tracking and CAPI installed", "Schema and pricing made machine-readable", "First AI agent set up"],
  },
  {
    window: "Days 31–60",
    title: "Launch and learn",
    items: ["Campaigns go live", "Instant follow-up starts working", "Agent workflows tuned", "Clear weekly updates"],
  },
  {
    window: "Days 61–90",
    title: "Optimize and compound",
    items: ["Budget follows revenue", "AI recommendations tracked", "Weak links get fixed", "Month four starts ahead"],
  },
];
---

<BaseLayout
  title="Services"
  description="AI agent setup, AI brand visibility, airtight ad tracking, and instant lead follow-up for local and e-commerce businesses."
>
  <section class="phase-hero phase-hero--services">
    <div class="container phase-hero__grid">
      <div>
        <p class="hero-kicker">AI-era growth and implementation</p>
        <h1>You run the AI. <span>We build the foundations.</span></h1>
        <p class="lead">
          Use modern agents like ChatGPT Dots, Meta Muse, and Instinct for daily execution while we
          handle tracking, paid media signals, and AI brand visibility.
        </p>
        <div class="cta-row">
          <a class="btn btn--primary" href="/ad-account-grader">Check my AI readiness <span aria-hidden="true">→</span></a>
          <a class="btn btn--secondary" href="/pricing">Compare engagement levels</a>
        </div>
      </div>
      <div class="service-orbit" role="img" aria-label="Four MaaxGen services connected in one continuous system">
        <div class="service-orbit__core"><strong>AI-ready</strong><span>your business</span></div>
        {pillars.map((pillar) => (
          <div class={`service-orbit__node service-orbit__node--${pillar.index}`}>
            <span>{pillar.index}</span>
            <strong>{pillar.title}</strong>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="growth-chain" aria-label="Connected service outcomes">
    <div class="container growth-chain__inner">
      <span>AI agents working</span><i aria-hidden="true">→</i>
      <span>Brand visible to AI</span><i aria-hidden="true">→</i>
      <span>Tracking locked in</span><i aria-hidden="true">→</i>
      <span>Instant follow-up</span>
    </div>
  </div>

  <section class="section service-system-section">
    <div class="container service-system-layout">
      <div class="service-system-intro" data-reveal>
        <p class="eyebrow">What we do</p>
        <h2>Four problems. Plain-English fixes.</h2>
        <p>
          Do AI platforms understand what I sell? Are my ads tracked properly? How do I use AI
          agents to save ten hours a week? Open any one to see the answer.
        </p>
      </div>
      <div class="service-accordions">
        {pillars.map((pillar, index) => (
          <details class="service-accordion" open={index === 0} data-reveal>
            <summary>
              <span>{pillar.index}</span>
              <div>
                <strong>{pillar.title}</strong>
                <small>{pillar.outcome}</small>
              </div>
            </summary>
            <div class="service-accordion__body">
              <p>{pillar.detail}</p>
              <ul>
                {pillar.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section lead-loop-section">
    <div class="container">
      <div class="lead-loop-heading" data-reveal>
        <div>
          <p class="eyebrow">Lead to learning loop</p>
          <h2>Every inquiry should make the next campaign smarter.</h2>
        </div>
        <p>
          The real advantage is not one campaign. It is a system that remembers what turned
          attention into revenue.
        </p>
      </div>
      <ol class="lead-loop">
        {leadJourney.map((stage, index) => (
          <li data-reveal style={`--reveal-delay: ${index * 0.08}s`}>
            <span>0{index + 1}</span>
            <p>{stage.when}</p>
            <h3>{stage.title}</h3>
            <small>{stage.detail}</small>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section audience-paths-section">
    <div class="container">
      <div class="section-heading section-heading--wide" data-reveal>
        <p class="eyebrow">Built around how customers buy</p>
        <h2>Local urgency and e-commerce consideration need different plays.</h2>
      </div>
      <div class="audience-paths">
        <article data-reveal>
          <span class="audience-paths__number">01</span>
          <p class="audience-paths__label">Local businesses</p>
          <h3>Turn nearby demand into calls, appointments, and visits.</h3>
          <p>Local search, reputation, offers, and fast follow-up work as one path.</p>
          <ul>
            <li>Home and automotive services</li>
            <li>Health and personal care</li>
            <li>Food and hospitality</li>
          </ul>
        </article>
        <article data-reveal style="--reveal-delay: 0.1s">
          <span class="audience-paths__number">02</span>
          <p class="audience-paths__label">E-commerce</p>
          <h3>Connect acquisition, merchandising, and retention.</h3>
          <p>Campaign creative and landing experiences stay aligned with margin and inventory.</p>
          <ul>
            <li>Home goods and specialty products</li>
            <li>Considered buying cycles</li>
            <li>Catalog and retention growth</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section first-90-section">
    <div class="container">
      <div class="first-90-heading" data-reveal>
        <p class="eyebrow">The first 90 days</p>
        <h2>No mystery. No six-month discovery phase.</h2>
        <p>We establish the truth, launch the priority, then improve what the market teaches us.</p>
      </div>
      <ol class="first-90-timeline">
        {expectations.map((phase, index) => (
          <li data-reveal style={`--reveal-delay: ${index * 0.08}s`}>
            <div class="first-90-timeline__marker"><span>0{index + 1}</span></div>
            <p>{phase.window}</p>
            <h3>{phase.title}</h3>
            <ul>{phase.items.map((item) => <li>{item}</li>)}</ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="home-final-cta">
    <div class="container home-final-cta__inner" data-reveal>
      <p>Not sure where to start?</p>
      <h2>Bring us the messy stack. We’ll show you what AI sees first.</h2>
      <a class="btn btn--primary" href="/contact">Start the conversation <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
