---
import BaseLayout from "../layouts/BaseLayout.astro";

const pillars = [
  {
    index: "01",
    title: "Strategy",
    outcome: "Know what to do next and why it matters.",
    detail:
      "We turn goals, margins, customer behavior, and market context into a focused 90-day plan.",
    items: ["Positioning and offers", "Campaign priorities", "Revenue-focused measurement"],
  },
  {
    index: "02",
    title: "Creative and web",
    outcome: "Give the right customer a reason to act.",
    detail:
      "Campaign messages, ads, and landing pages stay aligned from first impression through conversion.",
    items: ["Ad creative and copy", "Landing pages", "Conversion-focused website improvements"],
  },
  {
    index: "03",
    title: "Paid media",
    outcome: "Put the message in front of buyers with intent.",
    detail:
      "Search, social, and retargeting are managed against qualified leads, sales, and return.",
    items: ["Campaign management", "Creative testing", "Budget and channel decisions"],
  },
  {
    index: "04",
    title: "Follow-up and AI",
    outcome: "Turn more interest into revenue without adding busywork.",
    detail:
      "Practical automation responds faster, keeps opportunities moving, and organizes what the campaigns learn.",
    items: ["Speed-to-lead replies", "CRM workflows", "Human-reviewed AI operations"],
  },
];

const leadJourney = [
  { when: "Minute 1", title: "Inquiry answered", detail: "An on-brand response arrives while interest is high." },
  { when: "Day 1", title: "Next step booked", detail: "Reminders keep the opportunity moving without chasing spreadsheets." },
  { when: "Week 1", title: "Revenue connected", detail: "The pipeline shows what closed and which channel created it." },
  { when: "Next campaign", title: "Learning compounds", detail: "The result improves the next message, audience, and budget decision." },
];

const expectations = [
  {
    window: "Days 1–30",
    title: "Build the foundation",
    items: ["Goals and account access", "90-day roadmap", "Tracking and baseline", "Priority conversion fixes"],
  },
  {
    window: "Days 31–60",
    title: "Launch and learn",
    items: ["Campaigns go live", "Follow-up starts working", "Creative tests begin", "Clear weekly updates"],
  },
  {
    window: "Days 61–90",
    title: "Optimize and compound",
    items: ["Budget follows revenue", "Winning ideas expand", "Weak links get fixed", "Month four starts ahead"],
  },
];
---

<BaseLayout
  title="Services"
  description="One connected growth system spanning strategy, creative, paid media, websites, follow-up, and practical AI."
>
  <section class="phase-hero phase-hero--services">
    <div class="container phase-hero__grid">
      <div>
        <p class="hero-kicker">One team across the customer journey</p>
        <h1>Four capabilities. <span>One growth system.</span></h1>
        <p class="lead">
          Strategy, creative, media, and follow-up work better when the same accountable partner
          connects them.
        </p>
        <div class="cta-row">
          <a class="btn btn--primary" href="/contact">Map your growth system <span aria-hidden="true">→</span></a>
          <a class="btn btn--secondary" href="/pricing">See pricing</a>
        </div>
      </div>
      <div class="service-orbit" role="img" aria-label="Four MaaxGen services connected in one continuous system">
        <div class="service-orbit__core"><strong>Growth</strong><span>one plan</span></div>
        {pillars.map((pillar) => (
          <div class={`service-orbit__node service-orbit__node--${pillar.index}`}>
            <span>{pillar.index}</span>
            <strong>{pillar.title}</strong>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="growth-chain" aria-label="Connected service outcomes">
    <div class="container growth-chain__inner">
      <span>Find the priority</span><i aria-hidden="true">→</i>
      <span>Build the message</span><i aria-hidden="true">→</i>
      <span>Create demand</span><i aria-hidden="true">→</i>
      <span>Convert the interest</span>
    </div>
  </div>

  <section class="section service-system-section">
    <div class="container service-system-layout">
      <div class="service-system-intro" data-reveal>
        <p class="eyebrow">What we connect</p>
        <h2>Open any capability. See how it supports the whole.</h2>
        <p>
          You do not need four disconnected vendors. You need the right work happening in the
          right order.
        </p>
      </div>
      <div class="service-accordions">
        {pillars.map((pillar, index) => (
          <details class="service-accordion" open={index === 0} data-reveal>
            <summary>
              <span>{pillar.index}</span>
              <div>
                <strong>{pillar.title}</strong>
                <small>{pillar.outcome}</small>
              </div>
            </summary>
            <div class="service-accordion__body">
              <p>{pillar.detail}</p>
              <ul>
                {pillar.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section lead-loop-section">
    <div class="container">
      <div class="lead-loop-heading" data-reveal>
        <div>
          <p class="eyebrow">Lead to learning loop</p>
          <h2>Every inquiry should make the next campaign smarter.</h2>
        </div>
        <p>
          The real advantage is not one campaign. It is a system that remembers what turned
          attention into revenue.
        </p>
      </div>
      <ol class="lead-loop">
        {leadJourney.map((stage, index) => (
          <li data-reveal style={`--reveal-delay: ${index * 0.08}s`}>
            <span>0{index + 1}</span>
            <p>{stage.when}</p>
            <h3>{stage.title}</h3>
            <small>{stage.detail}</small>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section audience-paths-section">
    <div class="container">
      <div class="section-heading section-heading--wide" data-reveal>
        <p class="eyebrow">Built around how customers buy</p>
        <h2>Local urgency and e-commerce consideration need different plays.</h2>
      </div>
      <div class="audience-paths">
        <article data-reveal>
          <span class="audience-paths__number">01</span>
          <p class="audience-paths__label">Local businesses</p>
          <h3>Turn nearby demand into calls, appointments, and visits.</h3>
          <p>Local search, reputation, offers, and fast follow-up work as one path.</p>
          <ul>
            <li>Home and automotive services</li>
            <li>Health and personal care</li>
            <li>Food and hospitality</li>
          </ul>
        </article>
        <article data-reveal style="--reveal-delay: 0.1s">
          <span class="audience-paths__number">02</span>
          <p class="audience-paths__label">E-commerce</p>
          <h3>Connect acquisition, merchandising, and retention.</h3>
          <p>Campaign creative and landing experiences stay aligned with margin and inventory.</p>
          <ul>
            <li>Home goods and specialty products</li>
            <li>Considered buying cycles</li>
            <li>Catalog and retention growth</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section first-90-section">
    <div class="container">
      <div class="first-90-heading" data-reveal>
        <p class="eyebrow">The first 90 days</p>
        <h2>No mystery. No six-month discovery phase.</h2>
        <p>We establish the truth, launch the priority, then improve what the market teaches us.</p>
      </div>
      <ol class="first-90-timeline">
        {expectations.map((phase, index) => (
          <li data-reveal style={`--reveal-delay: ${index * 0.08}s`}>
            <div class="first-90-timeline__marker"><span>0{index + 1}</span></div>
            <p>{phase.window}</p>
            <h3>{phase.title}</h3>
            <ul>{phase.items.map((item) => <li>{item}</li>)}</ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="home-final-cta">
    <div class="container home-final-cta__inner" data-reveal>
      <p>Not sure which capability comes first?</p>
      <h2>Bring us the messy stack. We’ll map the next right move.</h2>
      <a class="btn btn--primary" href="/contact">Start the conversation <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
